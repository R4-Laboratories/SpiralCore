+#[cfg(test)]
+mod descriptor_tests {
+    use super::*;
+    use std::os::unix::fs::DirBuilderExt;
+
+    #[test]
+    fn relative_socket_observation_survives_original_directory_rename() {
+        let root = crate::TestDirectory::new();
+        let directory = root.0.join("live");
+        let moved = root.0.join("moved");
+        fs::DirBuilder::new()
+            .mode(0o700)
+            .create(&directory)
+            .unwrap();
+        let mut worker =
+            MailboxSocketWorker::prepare(File::open(&directory).unwrap(), &directory, ()).unwrap();
+        worker.start(|_| panic!("unexpected peer")).unwrap();
+        let socket = &worker.custody.as_ref().unwrap().socket;
+        let original = socket.entry().unwrap();
+        assert!(original.is_socket());
+        fs::rename(&directory, &moved).unwrap();
+        let socket = &worker.custody.as_ref().unwrap().socket;
+        let observed = socket.entry().unwrap();
+        assert_eq!(
+            (observed.device, observed.inode),
+            (original.device, original.inode)
+        );
+        assert!(worker.stop(crate::deadline()).is_err());
+        assert!(moved.join("mailbox.sock").exists());
+        fs::rename(&moved, &directory).unwrap();
+        worker.stop(crate::deadline()).unwrap();
+        assert!(!directory.join("mailbox.sock").exists());
+    }
+}
