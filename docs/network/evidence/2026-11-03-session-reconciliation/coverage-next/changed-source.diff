+        tracker: &mut ReceiptTracker,
+        outgoing: &MailboxBinding,
+        control: &MailboxBinding,
+        peer: &VerifyingKey,
+        now: ServiceTime,
+    ) -> Result<()> {
+        service.expire(now)?;
+        tracker.expire(now)?;
+        self.check_retry()?;
+        self.remaining(now)?;
