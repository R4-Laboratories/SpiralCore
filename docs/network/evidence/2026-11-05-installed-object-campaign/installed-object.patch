+pub(super) struct CampaignStore {
+    path: PathBuf,
+    identity: (u64, u64),
+    credit: NativeCredit,
+}
+impl CampaignStore {
+    pub(super) fn new(root: &Path, credit: ManagedReservation) -> Result<Self> {
+        let dir = tempfile::Builder::new()
+            .prefix("object-campaign-")
+            .tempdir_in(root.join("tmp"))?;
+        mvm_core::private_fs::set_mode(dir.path(), 0o700)?;
+        let metadata = std::fs::symlink_metadata(dir.path())?;
+        Ok(Self {
+            path: dir.keep(),
+            identity: (metadata.dev(), metadata.ino()),
+            credit: NativeCredit(Some(credit)),
+        })
+    }
+
+    pub(super) fn path(&self) -> &Path {
+        &self.path
+    }
+
+    fn verify_and_remove(mut self, host: &serde_json::Value) -> Result<()> {
+        let path = &self.path;
+        let metadata = std::fs::symlink_metadata(&path)?;
+        mvm_core::private_fs::require_current_owner(&metadata)?;
+        ensure!(
+            metadata.is_dir()
+                && metadata.mode() & 0o7777 == 0o700
+                && (metadata.dev(), metadata.ino()) == self.identity,
+            "original campaign store changed"
+        );
+        let published: Vec<crate::config::Published> =
+            serde_json::from_value(host["published"].clone())?;
+        crate::campaign::verify(
+            &mailbox_witness::object_campaign_plan(),
+            &path,
+            &published,
+            &mut std::io::sink(),
+        )
+        .map_err(|_| anyhow!("stopped campaign store exact readback failed"))?;
+        std::fs::remove_dir_all(path)?;
+        ensure!(
+            std::fs::symlink_metadata(path)
+                .is_err_and(|e| e.kind() == std::io::ErrorKind::NotFound)
+        );
+        self.credit.release();
+        Ok(())
+    }
+}
