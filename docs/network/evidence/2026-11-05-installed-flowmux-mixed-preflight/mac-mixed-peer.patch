+fn mixed_fixture() -> Result<Vec<u8>> {
+    use sha2::{Digest, Sha256};
+    let mut bytes = Vec::with_capacity(4 * 8192 * 38);
+    for segment in 0..4 {
+        let mut state = if segment == 3 { 19_u64 } else { 1 };
+        for row in 0..8192 {
+            state = (state * 48271) % 2147483647;
+            let change = u64::from(segment == 2 && row == 4096);
+            let value = 1000000000 + (state + change) % 1000000000;
+            writeln!(bytes, "{{\"kind\":\"flowmux\",\"value\":{value}}}")?;
+        }
+    }
+    require(
+        bytes.len() == 1_245_184
+            && spiralcore_transfer::hex(&Sha256::digest(&bytes).into())
+                == "cb8735a26e7674a87de33c29ad7ec8ccc18167f41f727e4bca922c5f775e4951",
+        "mixed fixture identity differs",
+    )?;
+    Ok(bytes)
+}
