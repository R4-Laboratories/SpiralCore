+    #[test]
+    fn wrong_purpose_writes_no_guest_challenge_proof() {
+        struct Counted {
+            io: Cursor<Vec<u8>>,
+            writes: usize,
+        }
+        impl Read for Counted {
+            fn read(&mut self, bytes: &mut [u8]) -> std::io::Result<usize> {
+                self.io.read(bytes)
+            }
+        }
+        impl Write for Counted {
+            fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+                self.writes += bytes.len();
+                Ok(bytes.len())
+            }
+            fn flush(&mut self) -> std::io::Result<()> {
+                Ok(())
+            }
+        }
+
+        let host = test_keypair();
+        let mut wire = Vec::new();
+        write_json_frame(
+            &mut wire,
+            &SessionHello {
+                version: PROTOCOL_VERSION_AUTHENTICATED,
+                session_id: "different-mailbox-purpose".into(),
+                challenge: vec![1; 32],
+                host_pubkey: host.verifying_key().to_bytes().to_vec(),
+                host_ephemeral_pubkey: vec![2; 32],
+            },
+            1 << 16,
+        )
+        .unwrap();
+        let mut counted = Counted {
+            io: Cursor::new(wire),
+            writes: 0,
+        };
+        assert!(matches!(
+            Session::guest_for_session(
+                &mut counted,
+                test_keypair(),
+                &host.verifying_key(),
+                "original-mailbox-purpose",
+            ),
+            Err(SessionError::InvalidHandshake(_))
+        ));
+        assert_eq!(counted.writes, 0);
+    }
