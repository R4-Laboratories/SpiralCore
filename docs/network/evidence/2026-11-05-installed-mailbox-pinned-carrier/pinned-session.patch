     #[test]
+    fn pinned_carrier_requires_the_enrolled_guest_and_original_session() {
+        for (guest_matches, scope_matches) in [(true, true), (false, true), (true, false)] {
+            let (mut host_io, mut guest_io) = pair();
+            let host_key = test_keypair();
+            let guest_key = test_keypair();
+            let host_pin = host_key.verifying_key();
+            let guest_pin = if guest_matches {
+                guest_key.verifying_key()
+            } else {
+                test_keypair().verifying_key()
+            };
+            let original = "installed-mailbox-replacement/one";
+            let expected = if scope_matches {
+                original
+            } else {
+                "other-boot"
+            };
+            std::thread::scope(|scope| {
+                let host = scope.spawn(move || {
+                    let result =
+                        Session::host_for_peer(&mut host_io, original, host_key, &guest_pin);
+                    if guest_matches && scope_matches {
+                        let mut session = result.unwrap();
+                        let sealed = session.seal(b"exact cached reply").unwrap();
+                        write_sealed_frame(&mut host_io, &sealed).unwrap();
+                    } else if !guest_matches {
+                        assert!(matches!(result, Err(SessionError::PeerIdentityMismatch(_))));
+                    } else {
+                        assert!(result.is_err());
+                    }
+                });
+                let result =
+                    Session::guest_for_session(&mut guest_io, guest_key, &host_pin, expected);
+                if guest_matches && scope_matches {
+                    let mut session = result.unwrap();
+                    let sealed = read_sealed_frame(&mut guest_io, 4096).unwrap();
+                    assert_eq!(session.open(&sealed).unwrap(), b"exact cached reply");
+                } else {
+                    if !scope_matches {
+                        assert!(matches!(result, Err(SessionError::InvalidHandshake(_))));
+                    } else {
+                        assert!(result.is_err());
+                    }
+                    drop(guest_io);
+                }
+                host.join().unwrap();
+            });
+        }
+    }
