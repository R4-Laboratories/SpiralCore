+#[cfg(test)]
+mod scan_diagnostic_tests {
+    use super::*;
+    use crate::scan_profile;
+
+    struct Policy;
+    impl Authority for Policy {
+        fn authorize(&self, _: &Context) -> Result<()> {
+            Ok(())
+        }
+    }
+    struct Temp(PathBuf);
+    impl Temp {
+        fn new() -> Self {
+            let path = std::env::temp_dir().join(format!(
+                "sc-scan-qualification-{}-{}",
+                std::process::id(),
+                TEMP.fetch_add(1, Ordering::Relaxed)
+            ));
+            assert!(!path.exists());
+            Self(path)
+        }
+    }
+    impl Drop for Temp {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+    #[test]
+    fn diagnostic_success_exact_counts_ignored_entries_and_reset() {
+        let temp = Temp::new();
+        let ep = Endpoint::open(&temp.0, Limits::default(), Policy).unwrap();
+        let active = temp.0.join(hex(&[1; 32]));
+        let other = temp.0.join(hex(&[2; 32]));
+        fs::create_dir(&active).unwrap();
+        fs::create_dir(&other).unwrap();
+        fs::create_dir(temp.0.join("ignored-dir")).unwrap();
+        fs::write(temp.0.join("root-noise"), b"ignored").unwrap();
+        fs::write(active.join("a.object"), b"123").unwrap();
+        fs::write(active.join("b.object"), b"12345").unwrap();
+        fs::write(active.join("skip.txt"), b"1234567").unwrap();
+        fs::create_dir(active.join("directory.object")).unwrap();
+        fs::write(other.join("c.object"), b"123456789").unwrap();
+        scan_profile::reset();
+        assert_eq!(ep.disk_usage([1; 32]), Ok((8, 17, 3)));
+        let p = scan_profile::take();
+        assert_eq!((p.calls, p.successes, p.errors), (1, 1, 0));
+        assert_eq!(
+            (
+                p.root_read_dir_calls,
+                p.root_entries,
+                p.root_file_type_calls
+            ),
+            (1, 6, 6)
+        );
+        assert_eq!(
+            (
+                p.namespace_read_dir_calls,
+                p.namespace_entries,
+                p.object_file_type_calls
+            ),
+            (2, 5, 5)
+        );
+        assert_eq!(
+            (
+                p.metadata_calls,
+                p.metadata_successes,
+                p.namespace_comparisons,
+                p.objects_counted
+            ),
+            (3, 3, 3, 3)
+        );
+        assert_eq!(
+            (
+                p.returned_scoped_bytes,
+                p.returned_all_bytes,
+                p.returned_objects
+            ),
+            (8, 17, 3)
+        );
+        assert_eq!(p.last_error, None);
+        assert!(!p.overflow);
+        assert!(p.wall_ns > 0);
+        assert_eq!(scan_profile::take(), Default::default());
+    }
+    #[test]
+    fn diagnostic_limit_error_is_retained_with_partial_counts() {
+        let temp = Temp::new();
+        let ep = Endpoint::open(
+            &temp.0,
+            Limits {
+                max_publications: 1,
+                ..Limits::default()
+            },
+            Policy,
+        )
+        .unwrap();
+        let active = temp.0.join(hex(&[1; 32]));
+        fs::create_dir(&active).unwrap();
+        fs::write(active.join("a.object"), b"123").unwrap();
+        fs::write(active.join("b.object"), b"12345").unwrap();
+        scan_profile::reset();
+        assert_eq!(ep.disk_usage([1; 32]), Err(Error::Limit));
+        let p = scan_profile::take();
+        assert_eq!((p.calls, p.successes, p.errors), (1, 0, 1));
+        assert_eq!(
+            (p.metadata_calls, p.metadata_successes, p.objects_counted),
+            (2, 2, 2)
+        );
+        assert_eq!(
+            (
+                p.returned_scoped_bytes,
+                p.returned_all_bytes,
+                p.returned_objects
+            ),
+            (0, 0, 0)
+        );
+        assert_eq!(p.last_error, Some(Error::Limit as u16));
+        assert_eq!(p.last_error_stage, Some("publication_count"));
+        assert!(!p.overflow);
+    }
+    #[test]
+    fn diagnostic_storage_error_is_retained_without_entries() {
+        let temp = Temp::new();
+        let ep = Endpoint::open(&temp.0, Limits::default(), Policy).unwrap();
+        fs::remove_dir_all(&temp.0).unwrap();
+        scan_profile::reset();
+        assert_eq!(ep.disk_usage([1; 32]), Err(Error::Storage));
+        let p = scan_profile::take();
+        assert_eq!(
+            (
+                p.calls,
+                p.successes,
+                p.errors,
+                p.root_read_dir_calls,
+                p.root_entries
+            ),
+            (1, 0, 1, 1, 0)
+        );
+        assert_eq!(p.last_error, Some(Error::Storage as u16));
+        assert_eq!(p.last_error_stage, Some("root_read_dir"));
+        assert!(!p.overflow);
+    }
+}
