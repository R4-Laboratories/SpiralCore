+#[test]
+fn attempted_dispatch_never_becomes_pre_dispatch_failure() {
+    let table = InstalledSlots::default();
+    let (_root, anchor, _) = owner("mailbox-attempted", 83);
+    let slot = table.reserve(&anchor).unwrap();
+    slot.arm_mailbox_dispatch().unwrap();
+    slot.mark_native_dispatch().unwrap();
+    assert!(slot.stop(&NoopConsoleStreamer).is_err());
+    assert!(slot.mark_native_dispatch().is_err());
+    {
+        let mut operation = slot.begin_operation().unwrap();
+        slot.finish_startup(
+            operation.state.as_mut().unwrap(),
+            Some(anyhow::anyhow!(
+                "driver failed without returning a VM handle"
+            )),
+        );
+    }
+    assert_eq!(
+        slot.dispatch.load(Ordering::Acquire),
+        NativeDispatch::AttemptedTerminal as u8
+    );
+    assert!(slot.stop(&NoopConsoleStreamer).is_err());
+    assert!(table.take_retired(&slot).is_err());
+}
