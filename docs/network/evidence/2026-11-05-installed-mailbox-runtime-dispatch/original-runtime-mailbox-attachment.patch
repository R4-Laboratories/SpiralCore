+#[test]
+fn installed_mailbox_slot_retains_before_start_and_cleans_without_native_receipt() {
+    use mvm_core::{
+        host_lifetime::{
+            CoreCurrentParentPermit, InstalledMailboxJob, InstalledMailboxOwner,
+            PreparedInstalledMailbox,
+        },
+        plan::{PlanId, sign_plan, test_support::PlanFixture},
+    };
+    use std::{
+        io::{Read, Write},
+        os::unix::net::UnixStream,
+        sync::mpsc,
+    };
+
+    struct Charge {
+        drops: Arc<AtomicUsize>,
+        entered: Option<mpsc::Sender<()>>,
+    }
+    impl Drop for Charge {
+        fn drop(&mut self) {
+            self.drops.fetch_add(1, Ordering::SeqCst);
+        }
+    }
+    impl InstalledMailboxOwner for Charge {
+        fn check_current(&self) -> Result<()> {
+            Ok(())
+        }
+        fn take_socket_job(&mut self) -> Result<InstalledMailboxJob> {
+            let entered = self
+                .entered
+                .take()
+                .context("fixture job already consumed")?;
+            Ok(Box::new(move |mut socket| {
+                socket.read_exact(&mut [0])?;
+                entered.send(()).unwrap();
+                assert_eq!(socket.read(&mut [0])?, 0);
+                Ok(())
+            }))
+        }
+    }
+    struct Permit {
+        binding: HostLaunchBinding,
+        charge: Mutex<Option<Charge>>,
+    }
+    impl CoreCurrentParentPermit for Permit {
+        fn check_current(&self, binding: &HostLaunchBinding) -> Result<()> {
+            anyhow::ensure!(*binding == self.binding, "foreign original grant");
+            Ok(())
+        }
+        fn prepare_installed_mailbox(
+            &self,
+            binding: &HostLaunchBinding,
+            plan_id: &PlanId,
+        ) -> Result<PreparedInstalledMailbox> {
+            let charge = self
+                .charge
+                .lock()
+                .unwrap()
+                .take()
+                .context("fixture charge already used")?;
+            Ok(PreparedInstalledMailbox::new(
+                binding.clone(),
+                plan_id.clone(),
+                Box::new(charge),
+            ))
+        }
+    }
+
+    let table = InstalledSlots::default();
+    let (root, anchor, _) = owner("mailbox-slot", 81);
+    let (_foreign_root, foreign, _) = owner("mailbox-slot-other", 82);
+    let mut config = VmStartConfig {
+        name: anchor.binding().vm_name.clone(),
+        cpus: 1,
+        memory_mib: 128,
+        ..Default::default()
+    };
+    anchor.bind_to_config(&mut config).unwrap();
+    let mut plan = PlanFixture::new().runtime_profile("firecracker").build();
+    plan.plan_id = mvm_core::plan::compute_plan_id(&plan);
+    config.plan_json = Some(
+        serde_json::to_string(&sign_plan(
+            &plan,
+            &ed25519_dalek::SigningKey::from_bytes(&[81; 32]),
+            "test",
+        ))
+        .unwrap(),
+    );
+    let backend = BackendKind::Firecracker;
+    anchor.bind_admitted(&config, backend, &plan).unwrap();
+    let drops = Arc::new(AtomicUsize::new(0));
+    let (entered, observed) = mpsc::channel();
+    let permit = Arc::new(Permit {
+        binding: anchor.binding().clone(),
+        charge: Mutex::new(Some(Charge {
+            drops: Arc::clone(&drops),
+            entered: Some(entered),
+        })),
+    });
+    anchor.bind_parent_permit(&config, backend, permit).unwrap();
+    anchor.prepare_installed_mailbox(&config, backend).unwrap();
+    let slot = table.reserve(&anchor).unwrap();
+    slot.pin_mailbox_directory(root.path().to_owned(), File::open(root.path()).unwrap())
+        .unwrap();
+    let other = table.reserve(&foreign).unwrap();
+    assert!(other.attach_prepared_mailbox(&config, backend).is_err());
+    slot.attach_prepared_mailbox(&config, backend).unwrap();
+    assert!(slot.attach_prepared_mailbox(&config, backend).is_err());
+    assert!(anchor.claim_for_native(&config, backend).is_err());
+    let path = root.path().join("mailbox.sock");
+    let mut peer = UnixStream::connect(&path).unwrap();
+    peer.write_all(&[1]).unwrap();
+    observed.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert_eq!(drops.load(Ordering::SeqCst), 0);
+    let startup_operation = slot.begin_operation().unwrap();
+    assert!(slot.stop(&NoopConsoleStreamer).is_err());
+    assert!(
+        slot.mark_native_dispatch().is_err(),
+        "stop must latch while custody is busy"
+    );
+    drop(startup_operation);
+    assert!(
+        path.exists(),
+        "startup in progress must retain the original mailbox until dispatch status is terminal"
+    );
+    assert_eq!(drops.load(Ordering::SeqCst), 0);
+    {
+        let mut operation = slot.begin_operation().unwrap();
+        slot.finish_startup(
+            operation.state.as_mut().unwrap(),
+            Some(anyhow::anyhow!("injected pre-native startup refusal")),
+        );
+    }
+    assert!(slot.stop(&NoopConsoleStreamer).is_err());
+    assert!(
+        !path.exists(),
+        "the real stop must clean up the mailbox despite absent native proof"
+    );
+    assert_eq!(drops.load(Ordering::SeqCst), 1);
+    assert!(
+        table.take_retired(&slot).is_err(),
+        "mailbox cleanup alone is not native proof"
+    );
+}
