+
+impl RecoveryPin {
+    fn authenticate<S: SocketIo + 'static>(
+        &self,
+        stream: &StreamTransport<S>,
+        role: HandshakeRole,
+        cancel: &CancellationToken,
+        deadline: Instant,
+    ) -> Result<()> {
+        let signing_key = SigningKey::from_bytes(&self.signing_key);
+        let peer = VerifyingKey::from_bytes(&self.peer)?;
+        let identity = match role {
+            HandshakeRole::Acceptor => ReplacementIdentity::Host {
+                signing_key: &signing_key,
+                expected_guest: &peer,
+            },
+            HandshakeRole::Initiator => ReplacementIdentity::Guest {
+                signing_key: &signing_key,
+                expected_host: &peer,
+            },
+        };
+        stream.authenticate_replacement(identity, &self.session, cancel, deadline)?;
+        Ok(())
+    }
+}
