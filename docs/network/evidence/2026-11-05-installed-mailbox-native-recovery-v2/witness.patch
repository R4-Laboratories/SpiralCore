+#[test]
+fn recovery_witness_replays_exact_reply_after_one_authenticated_redial() {
+    use mvm_core::host_lifetime::InstalledMailboxReplacementAcceptor;
+    use std::{io, time::Instant};
+
+    struct Once(Option<UnixStream>);
+    impl InstalledMailboxReplacementAcceptor for Once {
+        fn accept_after_clean_close(&mut self, deadline: Instant) -> io::Result<UnixStream> {
+            assert!(Instant::now() < deadline);
+            self.0
+                .take()
+                .ok_or_else(|| io::Error::other("fixture replacement already used"))
+        }
+    }
+    let (commitment, guest, host) = mailbox_witness::provision_recovery().unwrap();
+    assert_ne!(commitment, [0; 32]);
+    let guest =
