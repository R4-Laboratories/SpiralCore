+            io::{self, Read, Write},
+            os::unix::{
+                fs::{OpenOptionsExt, PermissionsExt},
+                net::UnixStream,
+            },
+            sync::atomic::AtomicUsize,
+            time::{Duration, Instant},
+        };
+
+        struct Parent(Arc<AtomicUsize>);
+        struct Owner;
+        impl InstalledMailboxOwner for Owner {
+            fn check_current(&self) -> Result<()> {
+                Ok(())
+            }
+            fn take_recovery_socket_job(&mut self) -> Result<InstalledMailboxRecoveryJob> {
+                Ok(Box::new(|mut original, acceptor| {
+                    let mut first = [0];
+                    original.read_exact(&mut first)?;
+                    let mut replacement = acceptor
+                        .accept_after_clean_close(Instant::now() + Duration::from_secs(1))?;
+                    let mut second = [0];
+                    replacement.read_exact(&mut second)?;
+                    assert_eq!([first[0], second[0]], [19, 29]);
+                    Ok(())
+                }))
+            }
+        }
+        impl CoreCurrentParentPermit for Parent {
+            fn check_current(&self, _: &HostLaunchBinding) -> Result<()> {
+                Ok(())
+            }
+            fn prepare_recovery_installed_mailbox(
+                &self,
+                binding: &HostLaunchBinding,
+                plan: &PlanId,
+                enrollment: [u8; 32],
+            ) -> Result<PreparedInstalledMailbox> {
+                self.0.fetch_add(1, Ordering::AcqRel);
+                assert_eq!(enrollment, [7; 32]);
+                PreparedInstalledMailbox::new_recovery(
+                    binding.clone(),
+                    plan.clone(),
+                    Box::new(Owner),
+                    enrollment,
+                )
+            }
+        }
+        struct Acceptor(Option<UnixStream>);
+        impl InstalledMailboxReplacementAcceptor for Acceptor {
+            fn accept_after_clean_close(&mut self, _: Instant) -> io::Result<UnixStream> {
+                self.0
+                    .take()
+                    .ok_or_else(|| io::Error::other("fixture replacement consumed"))
+            }
+        }
+
+        let root = tempfile::tempdir().unwrap();
+        fs::set_permissions(root.path(), fs::Permissions::from_mode(0o700)).unwrap();
+        let state = root.path().join("state");
+        fs::write(&state, b"v").unwrap();
+        fs::set_permissions(&state, fs::Permissions::from_mode(0o600)).unwrap();
+        let holder = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(root.path().join("holders"))
+            .unwrap();
+        let binding = HostLaunchBinding {
+            installation: [1; 32],
+            profile: [2; 32],
