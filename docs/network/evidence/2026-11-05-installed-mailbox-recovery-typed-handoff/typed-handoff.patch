+            .unwrap();
+        assert!(anchor.prepare_installed_mailbox(&config, backend).is_err());
+        assert!(
+            anchor
+                .prepare_recovery_installed_mailbox(&config, backend, [9; 32])
+                .is_err()
+        );
+        assert_eq!(calls.load(Ordering::Acquire), 0);
+        anchor
+            .prepare_recovery_installed_mailbox(&config, backend, [7; 32])
+            .unwrap();
+        assert_eq!(calls.load(Ordering::Acquire), 1);
+
+        let mut handoff = anchor
+            .take_installed_mailbox(&config, backend)
