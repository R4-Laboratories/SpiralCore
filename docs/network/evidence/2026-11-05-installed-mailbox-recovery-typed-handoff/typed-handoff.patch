+#[cfg(test)]
+mod recovery_mode_tests {
+    use super::*;
+    use crate::plan::{AssetIdentity, AssetKind, test_support::PlanFixture};
+
+    #[test]
+    fn signed_recovery_mode_requires_unique_policy_and_nonzero_enrollment() {
+        let mut plan = PlanFixture::new().runtime_profile("firecracker").build();
+        assert_eq!(mailbox_recovery_enrollment(&plan).unwrap(), None);
+        let profile = installed_mailbox_recovery_asset().unwrap();
+        plan.asset_identities.push(profile.clone());
+        assert!(mailbox_recovery_enrollment(&plan).is_err());
+
+        let enrollment = |digest: [u8; 32]| {
+            AssetIdentity::new(
+                AssetKind::Policy,
+                "installed_mailbox_session",
+                hex::encode(digest),
+            )
+            .unwrap()
+        };
+        plan.asset_identities.push(enrollment([0; 32]));
+        assert!(mailbox_recovery_enrollment(&plan).is_err());
+        plan.asset_identities.pop();
+        plan.asset_identities.push(enrollment([7; 32]));
+        assert_eq!(mailbox_recovery_enrollment(&plan).unwrap(), Some([7; 32]));
+        plan.asset_identities.push(enrollment([7; 32]));
+        assert!(mailbox_recovery_enrollment(&plan).is_err());
+        plan.asset_identities.pop();
+        plan.asset_identities.push(profile);
+        assert!(mailbox_recovery_enrollment(&plan).is_err());
+    }
+
