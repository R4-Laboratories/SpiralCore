+fn mailbox_recovery_enrollment(plan: &ExecutionPlan) -> Result<Option<[u8; 32]>> {
+    let expected = installed_mailbox_recovery_asset()?;
+    let mut profiles = plan
+        .asset_identities
+        .iter()
+        .filter(|asset| asset.name == expected.name);
+    let first = profiles.next();
+    if first != Some(&expected) {
+        ensure!(
+            !profiles.any(|asset| asset == &expected),
+            "installed mailbox recovery policy is ambiguous"
+        );
+        return Ok(None);
+    }
+    ensure!(
+        profiles.next().is_none(),
+        "installed mailbox recovery policy is ambiguous"
+    );
+    let mut enrollments = plan
+        .asset_identities
+        .iter()
+        .filter(|asset| asset.name == "installed_mailbox_session");
+    let asset = enrollments
+        .next()
+        .context("installed mailbox recovery enrollment missing")?;
+    ensure!(
+        asset.kind == crate::plan::AssetKind::Policy && enrollments.next().is_none(),
+        "installed mailbox recovery enrollment differs"
+    );
+    let mut digest = [0; 32];
+    hex::decode_to_slice(&asset.digest, &mut digest)?;
+    ensure!(
+        digest != [0; 32],
+        "installed mailbox recovery enrollment is empty"
+    );
+    Ok(Some(digest))
+}
