+/// Host selection for the dedicated installed mailbox service.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum InstalledMailboxLaunchProfile {
+    LinuxFirecrackerV1,
+}
+
+const INSTALLED_MAILBOX_ASSET: &str = "installed_mailbox";
+
+impl InstalledMailboxLaunchProfile {
+    /// Identity that the canonical signed plan must bind for this selection.
+    pub fn signed_asset(self) -> Result<mvm_core::plan::AssetIdentity> {
+        let profile: &[u8] = match self {
+            Self::LinuxFirecrackerV1 => b"mvm/installed-mailbox/local-firecracker/v1\0",
+        };
+        Ok(mvm_core::plan::AssetIdentity::new(
+            mvm_core::plan::AssetKind::Policy,
+            INSTALLED_MAILBOX_ASSET,
+            hex::encode(Sha256::digest(profile)),
+        )?)
+    }
 }
 
