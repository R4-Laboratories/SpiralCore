+#[test]
+fn installed_mailbox_selection_precedes_nonce_spend_and_unbound_dispatch() {
+    use mvm_core::plan::{AssetIdentity, AssetKind, NetworkMode};
+
+    let (_env, _home) = host_with_ceiling(Default::default());
+    let keys = tempfile::tempdir().unwrap();
+    let publisher = ed25519_dalek::SigningKey::from_bytes(&[36; 32]);
+    let (archive, pin) = make_test_bundle(&publisher, b"kernel-bytes", b"rootfs-bytes");
+    let key_id = key_id_from_pubkey(&publisher.verifying_key());
+    let trust = MapTrust(HashMap::from([(key_id, publisher.verifying_key())]));
+    let resolver = FixedResolver(archive);
+    let ctx = BundleAdmissionContext {
+        resolver: &resolver,
+        trust: &trust,
+        image: None,
+    };
+    let profile = InstalledMailboxLaunchProfile::LinuxFirecrackerV1;
+    let asset = profile.signed_asset().unwrap();
+    assert_eq!(asset.kind, AssetKind::Policy);
+    assert_eq!(asset.name, "installed_mailbox");
+    assert_eq!(
+        asset.digest,
+        "ae05972a2ff44bf3eae6c9dc33d60ac032616d1cae5d6463d44106f07cf54695"
+    );
+    let ordinary = RunPosture::on_backend(Variant::Dev, BackendKind::Firecracker);
+    let selected = ordinary.with_installed_mailbox(profile);
+    let admit = |plan: &ExecutionPlan, ledger: &InMemoryNonceLedger, posture| {
+        admit_plan_for_run(
+            plan,
+            &SystemClock,
+            ledger,
+            Some(keys.path()),
+            Some(&ctx),
+            None,
+            posture,
+        )
+    };
+    let mut input = input_with_pin("installed-mailbox-selection", &pin);
+    input.backend_name = "firecracker";
+    input.network_mode = NetworkMode::HostVsockProxy;
+    let plain = synthesize_plan(&input).unwrap();
+    let plain_ledger = InMemoryNonceLedger::new();
+    let error = admit(&plain, &plain_ledger, selected).unwrap_err();
+    assert!(format!("{error:#}").contains("installed mailbox selection requires"));
+    assert_eq!(
+        admit(&plain, &plain_ledger, ordinary)
+            .expect("selection without an asset must not spend the nonce")
+            .installed_mailbox(),
+        None
+    );
+
+    input.assets.push(asset.clone());
+    let plan = synthesize_plan(&input).unwrap();
+    let ledger = InMemoryNonceLedger::new();
+    let error = admit(&plan, &ledger, ordinary).unwrap_err();
+    assert!(format!("{error:#}").contains("installed mailbox requires explicit host selection"));
+    let admitted = admit(&plan, &ledger, selected).unwrap();
+    assert_eq!(admitted.installed_mailbox(), Some(profile));
+    let error = admit(&plan, &ledger, selected).unwrap_err();
+    assert!(matches!(
+        error.downcast_ref::<PlanValidityError>(),
+        Some(PlanValidityError::NonceReplay { .. })
+    ));
+
+    let backend = AnyBackend::from_hypervisor("mock");
+    let error = start_admitted(StartAdmittedParams {
+        backend: &backend,
+        admitted,
+        config: VmStartConfig::default(),
+        policy_bundle: None,
+        emitter: None,
+        assurance: None,
+    })
+    .unwrap_err();
+    assert!(format!("{error:#}").contains("admission gate refused (installed-mailbox)"));
+    assert!(format!("{error:#}").contains("original installed mailbox listener is unavailable"));
+    assert!(backend.list().unwrap().is_empty());
+
+    let incompatible =
+        RunPosture::on_backend(Variant::Dev, BackendKind::Mock).with_installed_mailbox(profile);
+    let error = admit(&plan, &InMemoryNonceLedger::new(), incompatible).unwrap_err();
+    assert!(format!("{error:#}").contains("bundled Linux Firecracker HostVsockProxy"));
+
+    let wrong_kind =
+        AssetIdentity::new(AssetKind::Other, "installed_mailbox", asset.digest.clone()).unwrap();
+    input.assets.clear();
+    input.assets.push(wrong_kind.clone());
+    let legacy = synthesize_plan(&input).unwrap();
+    let legacy_ledger = InMemoryNonceLedger::new();
+    let error = admit(&legacy, &legacy_ledger, selected).unwrap_err();
+    assert!(format!("{error:#}").contains("installed mailbox selection requires"));
+    assert_eq!(
+        admit(&legacy, &legacy_ledger, ordinary)
+            .expect("an unrelated asset kind must preserve ordinary admission")
+            .installed_mailbox(),
+        None
+    );
+    input.assets.push(asset.clone());
+    let duplicated = synthesize_plan(&input).unwrap();
+    let error = admit(&duplicated, &InMemoryNonceLedger::new(), selected).unwrap_err();
+    assert!(format!("{error:#}").contains("installed mailbox selection requires"));
+    input.assets.clear();
+    input
+        .assets
+        .push(AssetIdentity::new(AssetKind::Policy, "installed_mailbox", "a".repeat(64)).unwrap());
+    let wrong = synthesize_plan(&input).unwrap();
+    let error = admit(&wrong, &InMemoryNonceLedger::new(), selected).unwrap_err();
+    assert!(format!("{error:#}").contains("installed mailbox selection requires"));
+    input.assets[0] = asset;
+    input.network_mode = NetworkMode::None;
+    let offline = synthesize_plan(&input).unwrap();
+    let error = admit(&offline, &InMemoryNonceLedger::new(), selected).unwrap_err();
+    assert!(format!("{error:#}").contains("bundled Linux Firecracker HostVsockProxy"));
+    input.network_mode = NetworkMode::HostVsockProxy;
+    input.bundle_pin = None;
+    let unbundled = synthesize_plan(&input).unwrap();
+    let error = admit(&unbundled, &InMemoryNonceLedger::new(), selected).unwrap_err();
+    assert!(format!("{error:#}").contains("bundled Linux Firecracker HostVsockProxy"));
+}
