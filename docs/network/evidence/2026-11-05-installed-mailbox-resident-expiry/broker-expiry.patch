+//! A single funded shared-expiry worker for the retained mailbox broker.
+use crate::installed_parent::{
+    MAILBOX_WORKER_STACK_BYTES, ManagedClaim, ManagedReservation, native_thread_stack_terms,
+};
+use anyhow::{Result, ensure};
+use spiralcore_mvm_adapter::broker::BrokerContext;
+use std::{
+    panic::{AssertUnwindSafe, catch_unwind},
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+    thread::{self, JoinHandle},
+    time::Duration,
+};
+
+const CADENCE: Duration = Duration::from_millis(250);
+const STACK_BYTES: usize = MAILBOX_WORKER_STACK_BYTES as usize;
+
+pub(in crate::installed_parent) fn worker_claim() -> Result<ManagedClaim> {
+    Ok(ManagedClaim {
+        host_stack_bytes: native_thread_stack_terms(STACK_BYTES as u64)?.known_rust_bytes,
+        workers: 1,
+        ..ManagedClaim::default()
+    })
+}
+
+#[derive(Default)]
+struct State {
+    stop: AtomicBool,
+    failed: AtomicBool,
+}
+
+pub(in crate::installed_parent) struct BrokerMaintenance {
+    state: Arc<State>,
+    handle: Option<JoinHandle<()>>,
+    _credit: ManagedReservation,
+}
+
+impl BrokerMaintenance {
+    pub(super) fn start(context: BrokerContext, credit: ManagedReservation) -> Result<Self> {
+        credit.check_current()?;
+        let state = Arc::new(State::default());
+        let worker_state = Arc::clone(&state);
+        let handle = thread::Builder::new()
+            .name("spiralcore-mailbox-expiry".into())
+            .stack_size(STACK_BYTES)
+            .spawn(move || {
+                let outcome = catch_unwind(AssertUnwindSafe(|| {
+                    while !worker_state.stop.load(Ordering::Acquire) {
+                        thread::park_timeout(CADENCE);
+                        if !worker_state.stop.load(Ordering::Acquire) {
+                            context.try_expire_retained()?;
+                        }
+                    }
+                    Ok::<_, spiralcore_mvm_adapter::service::ServiceError>(())
+                }));
+                if !matches!(outcome, Ok(Ok(()))) {
+                    worker_state.failed.store(true, Ordering::Release);
+                }
+            })?;
+        Ok(Self {
+            state,
+            handle: Some(handle),
+            _credit: credit,
+        })
+    }
+
+    pub(super) fn check_running(&self) -> Result<()> {
+        self._credit.check_current()?;
+        ensure!(
+            !self.state.failed.load(Ordering::Acquire)
+                && self
+                    .handle
+                    .as_ref()
+                    .is_some_and(|handle| !handle.is_finished()),
+            "original mailbox expiry worker is unavailable"
+        );
+        Ok(())
+    }
+}
+
+impl Drop for BrokerMaintenance {
+    fn drop(&mut self) {
+        if let Some(handle) = self.handle.take() {
+            self.state.stop.store(true, Ordering::Release);
+            handle.thread().unpark();
+            // Maintenance uses only try-locks. It cannot wait on a mailbox
+            // dispatch held by an original worker during teardown.
+            let _ = handle.join();
+        }
+    }
+}
