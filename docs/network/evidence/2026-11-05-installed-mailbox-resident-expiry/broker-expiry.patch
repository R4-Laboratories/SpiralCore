+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::installed_parent::{endpoint_tests, tenant_tag};
+    use spiralcore_mvm_adapter::service::{HostBudget, ServiceError, ServiceLimits};
+
+    #[test]
+    fn maintenance_joins_while_dispatch_is_held_and_releases_its_charge() {
+        let (_home, mut supervisor, provider) = endpoint_tests::fixture();
+        let pool = supervisor.managed_resources().clone();
+        let baseline = pool.snapshot().unwrap().usage;
+        let context = BrokerContext::new(HostBudget::new(ServiceLimits::default()).unwrap());
+        let credit = pool
+            .reserve(tenant_tag("test-expiry-owner"), worker_claim().unwrap())
+            .unwrap();
+        let worker = BrokerMaintenance::start(context.clone(), credit).unwrap();
+        let (completed_tx, completed_rx) = std::sync::mpsc::sync_channel(1);
+        let (dropper, joined_while_busy) = context
+            .with_time(|_, _| -> Result<_, ServiceError> {
+                thread::sleep(CADENCE + Duration::from_millis(100));
+                let dropper = thread::spawn(move || {
+                    drop(worker);
+                    let _ = completed_tx.send(());
+                });
+                let joined = completed_rx.recv_timeout(Duration::from_secs(1)).is_ok();
+                Ok((dropper, joined))
+            })
+            .unwrap();
+        dropper.join().unwrap();
+        assert!(joined_while_busy, "maintenance join waited for dispatch");
+        assert_eq!(pool.snapshot().unwrap().usage, baseline);
+        drop((provider, pool));
+        supervisor.close_admission();
+        supervisor.try_finish().unwrap();
+    }
+
+    #[test]
+    fn poisoned_dispatch_refuses_the_original_worker_until_teardown() {
+        let (_home, mut supervisor, provider) = endpoint_tests::fixture();
+        let pool = supervisor.managed_resources().clone();
+        let baseline = pool.snapshot().unwrap().usage;
+        let context = BrokerContext::new(HostBudget::new(ServiceLimits::default()).unwrap());
+        let credit = pool
+            .reserve(tenant_tag("test-expiry-owner"), worker_claim().unwrap())
+            .unwrap();
+        let worker = BrokerMaintenance::start(context.clone(), credit).unwrap();
+        assert!(
+            catch_unwind(AssertUnwindSafe(|| {
+                let _: Result<(), ServiceError> =
+                    context.with_time(|_, _| panic!("poison expiry fixture"));
+            }))
+            .is_err()
+        );
+        let deadline = std::time::Instant::now() + Duration::from_secs(2);
+        while worker.check_running().is_ok() && std::time::Instant::now() < deadline {
+            thread::sleep(Duration::from_millis(15));
+        }
+        assert!(worker.check_running().is_err());
+        assert_eq!(pool.snapshot().unwrap().usage.workers, baseline.workers + 1);
+        drop(worker);
+        assert_eq!(pool.snapshot().unwrap().usage, baseline);
+        drop((provider, pool));
+        supervisor.close_admission();
+        supervisor.try_finish().unwrap();
+    }
+}
