+fn expire_retained(b: &mut BudgetState, now: u64) -> Result<usize> {
+    expire_control_rates(b, now);
+    let expired: Vec<_> = b
+        .accepted
+        .iter()
+        .filter_map(|(key, v)| (now >= v.retention).then_some(*key))
+        .collect();
+    for key in &expired {
+        let record = b.accepted.remove(key).ok_or(ServiceError::State)?;
+        release_usage(
+            b,
+            record.scope,
+            Usage {
+                identities: 1,
+                ..Usage::default()
+            },
+            BudgetClass::Data,
+            None,
+        );
+    }
+    b.arrivals.retain(|_, arrivals| {
+        while arrivals
+            .front()
+            .is_some_and(|t| now.saturating_sub(*t) >= 60_000)
+        {
+            arrivals.pop_front();
+        }
+        !arrivals.is_empty()
+    });
+    Ok(expired.len())
