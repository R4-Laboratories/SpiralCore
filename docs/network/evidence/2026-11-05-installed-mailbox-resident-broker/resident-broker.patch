+#[cfg(all(target_os = "linux", target_pointer_width = "64"))]
+#[test]
+fn resident_mailbox_replay_survives_retirement_of_the_last_worker() {
+    use crate::config::{Arm, Pair, Plan, Stage};
+    use mvm_contract::protocol::mailbox::{ContentType, DeliveryOutcome};
+    use mvm_core::mailbox::encode_envelope;
+    use spiralcore_mvm_adapter::{
+        CONTENT_TYPE,
+        service_sender::{self, MessageOptions},
+    };
+    use std::os::unix::net::UnixStream;
+
+    let (home, mut supervisor, provider) = endpoint_tests::fixture();
+    let baseline = supervisor.managed_resources().snapshot().unwrap().usage;
+    let pair = Pair::provision(Plan {
+        stage: Stage::Two,
+        arm: Arm::Warm,
+        size: 128,
+        trial: 1,
+        bandwidth_profile: Default::default(),
+    })
+    .unwrap();
+    let outgoing = pair.sender.outgoing.as_ref().unwrap();
+    let outbound = outgoing.service_binding(None).unwrap();
+    let broker = crate::campaign::broker_context().unwrap();
+    let wire = broker
+        .with_time(|_, now| -> crate::Result<_> {
+            let mut options = MessageOptions::fresh(
+                ContentType::parse(CONTENT_TYPE, 1)?,
+                now,
+                now.unix_ms + 10_000,
+            )?;
+            options.reply_to = outgoing.reply_to;
+            Ok(encode_envelope(
+                service_sender::prepare(&outbound, b"resident replay", &options, now)?.envelope(),
+            )?)
+        })
+        .unwrap();
+    let receiver = pair.receiver.incoming.unwrap();
+    let signing = pair.receiver.service.unwrap().local_receipt_signing;
+    let mut original_receipt = None;
+    for (name, outcome) in [
+        ("resident-replay-first", DeliveryOutcome::AcceptedEphemeral),
+        ("resident-replay-second", DeliveryOutcome::Duplicate),
+    ] {
+        let admitted = admitted_with_mailbox(home.path(), name, true);
+        let (grant, mut config) = config(&provider, name);
+        config.plan_json = Some(serde_json::to_string(admitted.signed()).unwrap());
+        let permit = provider
+            .bind_config(&admitted, &config, native_backend())
+            .unwrap();
+        let anchor = config.host_lifetime.as_ref().unwrap();
+        anchor
+            .bind_parent_permit(&config, native_backend(), permit)
+            .unwrap();
+        let source = receiver.service_binding(Some(signing)).unwrap();
+        let wire = wire.clone();
+        let (send, receive) = std::sync::mpsc::sync_channel(1);
+        grant
+            .install_mailbox_job(&admitted, move |_, broker, service| {
+                let receipt = broker
+                    .with_time(|_, now| service.admit(&source, &wire, now))
+                    .map_err(std::io::Error::other)?;
+                send.send(receipt).map_err(std::io::Error::other)
+            })
+            .unwrap();
+        anchor
+            .prepare_installed_mailbox(&config, native_backend())
+            .unwrap();
+        let mut handoff = anchor
+            .take_installed_mailbox(&config, native_backend())
+            .unwrap()
+            .unwrap();
+        let (_peer, server) = UnixStream::pair().unwrap();
+        handoff.take_socket_job().unwrap()(server).unwrap();
+        let receipt = receive.try_recv().unwrap();
+        assert_eq!(
+            receipt.receipt.outcome, outcome,
+            "last-worker retirement forgot the accepted envelope"
+        );
+        if let Some(previous) = &original_receipt {
+            assert_eq!(receipt.receipt.message_id, *previous);
+        } else {
+            original_receipt = Some(receipt.receipt.message_id);
+        }
+        handoff.confirm_socket_retired().unwrap();
+        drop(handoff);
+        assert!(grant.lifecycle.lock().unwrap().seal_retired().is_ok());
+        drop((config, grant));
+        assert_eq!(
+            supervisor.managed_resources().snapshot().unwrap().usage,
+            ManagedClaim {
+                host_metadata_bytes: baseline.host_metadata_bytes + MIB,
+                ..baseline
+            },
+        );
+    }
+    drop(provider);
+    supervisor.close_admission();
+    supervisor.try_finish().unwrap();
+}
