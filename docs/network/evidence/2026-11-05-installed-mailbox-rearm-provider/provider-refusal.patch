+#[cfg(target_os = "linux")]
+#[test]
+fn recovery_profile_cannot_bind_the_original_parent_before_rearm_is_supported() {
+    let (home, supervisor, provider) = endpoint_tests::fixture();
+    let name = "signed-recovery-refused-before-binding";
+    let admitted = admitted_with_profile(
+        home.path(),
+        name,
+        Some(InstalledMailboxLaunchProfile::LinuxFirecrackerRecoveryV2),
+        Some(InstalledMailboxEnrollment::new([93; 32]).unwrap()),
+    );
+    let (grant, mut config) = config(&provider, name);
+    config.plan_json = Some(serde_json::to_string(admitted.signed()).unwrap());
+    let before = supervisor.managed_resources().snapshot().unwrap().usage;
+    let error = provider
+        .bind_config(&admitted, &config, native_backend())
+        .err()
+        .unwrap();
+    assert!(
+        format!("{error:#}")
+            .contains("original installed mailbox replacement authority is unavailable")
+    );
+    assert_eq!(
+        supervisor.managed_resources().snapshot().unwrap().usage,
+        before
+    );
+    assert!(grant.lifecycle.lock().unwrap().mailbox_enrollment.is_none());
+}
