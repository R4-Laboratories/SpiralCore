+#[cfg(test)]
+mod deadline_tests {
+    use super::*;
+    use std::os::linux::net::SocketAddrExt;
+    use std::os::unix::net::{UnixListener, UnixStream};
+
+    #[test]
+    fn replacement_wait_expires_while_listener_is_idle() {
+        let (listener, _idle) = UnixStream::pair().unwrap();
+        let (_writer, wake) = UnixStream::pair().unwrap();
+        let deadline = Instant::now() + Duration::from_millis(15);
+        let error =
+            wait_for_peer(listener.as_raw_fd(), wake.as_raw_fd(), Some(deadline)).unwrap_err();
+        assert_eq!(error.kind(), io::ErrorKind::TimedOut);
+        assert!(Instant::now() >= deadline);
+    }
+
+    #[test]
+    fn replacement_wait_never_uses_ready_listener_after_deadline() {
+        let (listener, writer) = UnixStream::pair().unwrap();
+        writer.shutdown(std::net::Shutdown::Write).unwrap();
+        let (_stop, wake) = UnixStream::pair().unwrap();
+        let error = wait_for_peer(listener.as_raw_fd(), wake.as_raw_fd(), Some(Instant::now()))
+            .unwrap_err();
+        assert_eq!(error.kind(), io::ErrorKind::TimedOut);
+    }
+
+    #[test]
+    fn replacement_wait_gives_stop_priority_over_a_ready_listener() {
+        let listener = UnixListener::bind_addr(
+            &std::os::unix::net::SocketAddr::from_abstract_name(format!(
+                "mvm-mailbox-stop-{}",
+                std::process::id()
+            ))
+            .unwrap(),
+        )
+        .unwrap();
+        let _peer = UnixStream::connect_addr(&listener.local_addr().unwrap()).unwrap();
+        let (stop, wake) = UnixStream::pair().unwrap();
+        stop.shutdown(std::net::Shutdown::Write).unwrap();
+        assert!(
+            !wait_for_peer(
+                listener.as_raw_fd(),
+                wake.as_raw_fd(),
+                Some(Instant::now() + Duration::from_secs(1)),
+            )
+            .unwrap()
+        );
+        assert!(listener.accept().is_ok());
+    }
+
+    #[test]
+    fn replacement_wait_observes_ready_before_deadline() {
+        let (listener, writer) = UnixStream::pair().unwrap();
+        writer.shutdown(std::net::Shutdown::Write).unwrap();
+        let (_stop, wake) = UnixStream::pair().unwrap();
+        assert!(
+            wait_for_peer(
+                listener.as_raw_fd(),
+                wake.as_raw_fd(),
+                Some(Instant::now() + Duration::from_secs(1)),
+            )
+            .unwrap()
+        );
+    }
+}
