+//! Fixed installed qualification dose using the existing raw object frames.
+use super::*;
+use transfer::protocol::{Mode, Offer};
+
+pub(crate) const OBJECT_BYTES: usize = 3 << 20;
+const CHUNK: usize = 4 << 10;
+pub(crate) const OBJECTS: usize = 3;
+pub(crate) const CALLS: u64 = 1 + (OBJECTS * (OBJECT_BYTES / CHUNK + 2)) as u64;
+pub(crate) const RUN_LIMIT: Duration = Duration::from_secs(900);
+pub(super) const INTERVAL: Duration = Duration::from_millis(250);
+
+pub(super) fn fixtures(plan: &Plan) -> Result<Vec<Fixture>> {
+    if plan.stage != crate::config::Stage::Two
+        || plan.arm != Arm::Raw
+        || plan.size != OBJECT_BYTES
+        || plan.trial != 2
+    {
+        return Err("installed sustained fixture plan differs".into());
+    }
+    Ok((0..OBJECTS)
+        .map(|i| Fixture {
+            kind: "sustained-raw",
+            bytes: crate::fixtures::opaque(OBJECT_BYTES, 0x5343_5355_5354_0000 + i as u64),
+        })
+        .collect())
+}
+
+pub(super) fn send(
+    bytes: &[u8],
+    transfer: Id,
+    exchange: &mut impl FnMut(&[Frame]) -> transfer::Result<Vec<Frame>>,
+) -> transfer::Result<Stats> {
+    use transfer::Error;
+    if bytes.len() != OBJECT_BYTES {
+        return Err(Error::Limit);
+    }
+    let started = Instant::now();
+    let offer = Offer::cold(bytes, Mode::Raw);
+    let mut stats = Stats {
+        object: offer.object,
+        mode: Mode::Raw,
+        request_bytes: 0,
+        response_bytes: 0,
+        data_bytes: 0,
+        records_sent: 0,
+        requests: 0,
+        elapsed_micros: 0,
+    };
+    let mut call = |kind, body| -> transfer::Result<Frame> {
+        let seq = stats.requests as u64;
+        let frame = Frame {
+            kind,
+            transfer,
+            seq,
+            body,
+        };
+        let replies = exchange(std::slice::from_ref(&frame))?;
+        let [reply]: [Frame; 1] = replies.try_into().map_err(|_| Error::Integrity)?;
+        if reply.transfer != transfer || reply.seq != seq {
+            return Err(Error::Integrity);
+        }
+        stats.request_bytes += frame.encode()?.len() as u64;
+        stats.response_bytes += reply.encode()?.len() as u64;
+        stats.requests += 1;
+        Ok(reply)
+    };
+    let ready = call(1, offer.encode()?)?;
+    let mut expected = vec![Mode::Raw as u8, 0];
+    expected.extend_from_slice(&1_u64.to_le_bytes());
+    if ready.kind != 101 || ready.body != expected {
+        return Err(Error::Integrity);
+    }
+    for chunk in bytes.chunks_exact(CHUNK) {
+        let mut body = Vec::with_capacity(5 + CHUNK);
+        body.push(0);
+        body.extend_from_slice(&(CHUNK as u32).to_le_bytes());
+        body.extend_from_slice(chunk);
+        let reply = call(2, body)?;
+        if reply.kind != 102 || reply.body.len() != 8 {
+            return Err(Error::Integrity);
+        }
+    }
+    let done = call(3, Vec::new())?;
+    if done.kind != 103 || done.body != offer.object {
+        return Err(Error::Integrity);
+    }
+    stats.data_bytes = bytes.len() as u64;
+    stats.elapsed_micros = started.elapsed().as_micros();
+    Ok(stats)
+}
