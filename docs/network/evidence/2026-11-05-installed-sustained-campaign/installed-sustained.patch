+fn ensure_sustained_authority(endpoint: &Bootstrap) -> Result<()> {
+    let service = endpoint
+        .service
+        .as_ref()
+        .ok_or("missing sustained controls")?;
+    let minimum_expiry = i64::try_from(
+        (std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?
+            + campaign::sustained::RUN_LIMIT
+            + Duration::from_secs(30))
+        .as_millis(),
+    )?;
+    for material in [
+        endpoint
+            .incoming
+            .as_ref()
+            .ok_or("missing sustained incoming grant")?,
+        endpoint
+            .outgoing
+            .as_ref()
+            .ok_or("missing sustained outgoing grant")?,
+        &service.incoming_control,
+        &service.outgoing_control,
+    ] {
+        if material.capability.grant.expires_at_unix_ms <= minimum_expiry
+            || material.binding.claims.expires_at_unix_ms <= minimum_expiry
+        {
+            return Err("insufficient remaining sustained mailbox authority".into());
+        }
+    }
+    Ok(())
+}
