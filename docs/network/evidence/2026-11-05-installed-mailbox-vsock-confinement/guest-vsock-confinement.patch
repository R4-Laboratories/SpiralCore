+/// Fail the native witness if the booted agent did not confine the workload.
+/// This creates no Internet connection and closes an unexpected descriptor.
+fn check_guest_confinement() -> Result<()> {
+    // SAFETY: these queries pass only scalar values. socket either returns a
+    // fresh, exclusively owned descriptor or fails without creating one.
+    unsafe {
+        if libc::prctl(libc::PR_GET_SECCOMP, 0, 0, 0, 0) != 2 {
+            return Err("guest workload seccomp filter missing".into());
+        }
+        let fd = libc::socket(libc::AF_INET, libc::SOCK_STREAM | libc::SOCK_CLOEXEC, 0);
+        if fd >= 0 {
+            libc::close(fd);
+            return Err("guest workload unexpectedly permits Internet sockets".into());
+        }
+        if std::io::Error::last_os_error().raw_os_error() != Some(libc::EPERM) {
+            return Err("guest workload Internet-socket confinement was not established".into());
+        }
+    }
+    Ok(())
+}
