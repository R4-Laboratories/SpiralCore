+//! The guest stream uses only operations admitted by MVM's Vsock tier.
+use rustix::fs::{OFlags, fcntl_getfl, fcntl_setfl};
+use spiralcore_mvm_adapter::live::SocketIo;
+use std::{
+    cell::Cell,
+    io::{self, Read, Write},
+    net::Shutdown,
+    os::{fd::AsRawFd, unix::net::UnixStream},
+    time::Duration,
+};
+
+pub(super) struct GuestSocket {
+    // The fixture exclusively owns this descriptor. Full shutdown drops it,
+    // even if a logical transport handle is retained after an I/O failure.
+    stream: Cell<Option<UnixStream>>,
+    read_timeout: Cell<Option<Duration>>,
+    write_timeout: Cell<Option<Duration>>,
+}
+
+impl GuestSocket {
+    pub(super) fn new(stream: UnixStream) -> io::Result<Self> {
+        let flags = fcntl_getfl(&stream)?;
+        fcntl_setfl(&stream, flags | OFlags::NONBLOCK)?;
+        Ok(Self {
+            stream: Cell::new(Some(stream)),
+            read_timeout: Cell::new(None),
+            write_timeout: Cell::new(None),
+        })
+    }
+
+    fn wait_io(
+        &mut self,
+        events: libc::c_short,
+        timeout: Option<Duration>,
+        mut operation: impl FnMut(&mut UnixStream) -> io::Result<usize>,
+    ) -> io::Result<usize> {
+        let stream = self
+            .stream
+            .get_mut()
+            .as_mut()
+            .ok_or(io::ErrorKind::NotConnected)?;
+        let timeout = timeout.ok_or(io::ErrorKind::InvalidInput)?;
+        match operation(stream) {
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => {}
+            result => return result,
+        }
+        let mut descriptor = libc::pollfd {
+            fd: stream.as_raw_fd(),
+            events,
+            revents: 0,
+        };
+        let timeout = libc::timespec {
+            tv_sec: timeout
+                .as_secs()
+                .try_into()
+                .map_err(|_| io::ErrorKind::InvalidInput)?,
+            tv_nsec: timeout.subsec_nanos() as libc::c_long,
+        };
+        // SAFETY: both structures are initialized and live for the syscall,
+        // and stream owns the nonblocking fd throughout this operation.
+        match unsafe { libc::ppoll(&mut descriptor, 1, &timeout, std::ptr::null()) } {
+            -1 => Err(io::Error::last_os_error()),
+            0 => Err(io::ErrorKind::TimedOut.into()),
+            // Retry nonblocking I/O on readiness, including error/hangup, so
+            // buffered data, EOF, and the socket error keep their usual meaning.
+            _ => operation(stream),
+        }
+    }
+}
+
+fn set_timeout(slot: &Cell<Option<Duration>>, timeout: Option<Duration>) -> io::Result<()> {
+    if timeout.is_none_or(|value| value.is_zero()) {
+        return Err(io::ErrorKind::InvalidInput.into());
+    }
+    slot.set(timeout);
+    Ok(())
+}
+
+impl SocketIo for GuestSocket {
+    fn set_read_timeout(&self, timeout: Option<Duration>) -> io::Result<()> {
+        set_timeout(&self.read_timeout, timeout)
+    }
+
+    fn set_write_timeout(&self, timeout: Option<Duration>) -> io::Result<()> {
+        set_timeout(&self.write_timeout, timeout)
+    }
+
+    fn shutdown(&self, how: Shutdown) -> io::Result<()> {
+        if how != Shutdown::Both {
+            return Err(io::ErrorKind::Unsupported.into());
+        }
+        drop(self.stream.take());
+        Ok(())
+    }
+}
+
+impl Read for GuestSocket {
+    fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+        self.wait_io(libc::POLLIN, self.read_timeout.get(), |stream| {
+            stream.read(bytes)
+        })
+    }
+}
+
+impl Write for GuestSocket {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.wait_io(libc::POLLOUT, self.write_timeout.get(), |stream| {
+            stream.write(bytes)
+        })
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        // Writes go directly to the socket.
+        Ok(())
+    }
+}
