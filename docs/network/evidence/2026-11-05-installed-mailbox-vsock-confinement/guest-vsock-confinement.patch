+#[test]
+fn guest_exchange_under_canonical_vsock_seccomp() {
+    use mvm_agentd::workload_seccomp;
+    use mvm_core::crypto::seccomp::SeccompTier;
+
+    let (_, guest, host) = mailbox_witness::provision().unwrap();
+    let (host_socket, guest_socket) = UnixStream::pair().unwrap();
+    let worker = std::thread::spawn(move || {
+        let broker = crate::campaign::broker_context().unwrap();
+        let mut service = broker
+            .with_time(|budget, _| {
+                spiralcore_mvm_adapter::service::LocalMailboxService::new(budget.clone())
+            })
+            .unwrap();
+        host.run(host_socket, &broker, &mut service)
+    });
+    let filter = workload_seccomp::compile(SeccompTier::Vsock)
+        .unwrap()
+        .unwrap();
+    let result = std::thread::spawn(move || {
+        workload_seccomp::install(&filter).unwrap();
+        mailbox_witness::check_guest_confinement()?;
+        guest.exchange(guest_socket)
+    })
+    .join()
+    .unwrap()
+    .expect("exact guest exchange under MVM's canonical Vsock tier");
+    let server = worker.join().unwrap().unwrap();
+    assert_eq!(result.call_bytes, 65_023);
+    assert_eq!(result.reply_bytes, 65_023);
+    assert_eq!(result.cast_bytes, 23);
+    assert_eq!(
+        result.counters.envelope_bytes_sent,
+        server.counters.envelope_bytes_received
+    );
+    assert_eq!(
+        result.counters.envelope_bytes_received,
+        server.counters.envelope_bytes_sent
+    );
+}
+
+#[test]
+fn confined_guest_bounds_idle_reads_and_backpressured_writes_and_closes() {
+    use mvm_agentd::workload_seccomp;
+    use mvm_core::crypto::seccomp::SeccompTier;
+    use spiralcore_mvm_adapter::live::SocketIo;
+    use std::{
+        io::{ErrorKind, Read, Write},
+        net::Shutdown,
+        time::{Duration, Instant},
+    };
+
+    let filter = workload_seccomp::compile(SeccompTier::Vsock)
+        .unwrap()
+        .unwrap();
+    let (host, guest) = UnixStream::pair().unwrap();
+    let (host_write, guest_write) = UnixStream::pair().unwrap();
+    let (host_tx, host_rx) = std::sync::mpsc::channel();
+    let worker = std::thread::spawn(move || {
+        workload_seccomp::install(&filter).unwrap();
+        let mut guest = super::GuestSocket::new(guest).unwrap();
+        let mut guest_write = super::GuestSocket::new(guest_write).unwrap();
+        let timeout = Duration::from_millis(20);
+        guest.set_read_timeout(Some(timeout)).unwrap();
+        guest_write.set_write_timeout(Some(timeout)).unwrap();
+
+        let start = Instant::now();
+        assert_eq!(
+            guest.read(&mut [0]).unwrap_err().kind(),
+            ErrorKind::TimedOut
+        );
+        assert!(start.elapsed() >= timeout && start.elapsed() < Duration::from_secs(2));
+
+        let bytes = [0_u8; 65_536];
+        let mut timed_out = false;
+        for _ in 0..128 {
+            let start = Instant::now();
+            match guest_write.write(&bytes) {
+                Ok(written) => assert!(written > 0),
+                Err(error) => {
+                    assert_eq!(error.kind(), ErrorKind::TimedOut);
+                    assert!(start.elapsed() >= timeout && start.elapsed() < Duration::from_secs(2));
+                    timed_out = true;
+                    break;
+                }
+            }
+        }
+        assert!(timed_out);
+        guest.shutdown(Shutdown::Both).unwrap();
+        guest.shutdown(Shutdown::Both).unwrap();
+        assert_eq!(
+            guest.read(&mut [0]).unwrap_err().kind(),
+            ErrorKind::NotConnected
+        );
+        host_tx.send(()).unwrap();
+    });
+    host_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+    let mut host = host;
+    host.set_read_timeout(Some(Duration::from_secs(1))).unwrap();
+    assert_eq!(host.read(&mut [0]).unwrap(), 0);
+    worker.join().unwrap();
+    drop(host_write);
+}
