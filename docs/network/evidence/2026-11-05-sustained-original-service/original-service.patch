@@ -0,0 +1,125 @@
+use super::*;
+use crate::config::{Arm, Pair, Plan, Stage};
+use spiralcore_transfer::protocol::{Mode, Offer};
+use std::os::unix::net::UnixStream;
+
+fn pair() -> Pair {
+    Pair::provision(Plan {
+        stage: Stage::Two,
+        arm: Arm::Raw,
+        size: 128,
+        trial: 0,
+        bandwidth_profile: Default::default(),
+    })
+    .unwrap()
+}
+
+fn service_for(broker: &BrokerContext) -> LocalMailboxService {
+    broker
+        .with_time(|budget, _| LocalMailboxService::new(budget.clone()))
+        .unwrap()
+}
+
+#[test]
+fn foreign_service_is_refused_before_campaign_dispatch() {
+    let pair = pair();
+    let broker = broker_context().unwrap();
+    let foreign = broker_context().unwrap();
+    let mut original = service_for(&foreign);
+    let before = original.snapshot();
+    assert!(matches!(
+        Session::with_service(&pair.receiver, &broker, |_| Ok(&mut original))
+            .err()
+            .unwrap()
+            .downcast_ref::<ServiceError>(),
+        Some(ServiceError::State)
+    ));
+    let after = original.snapshot();
+    assert_eq!(
+        (
+            before.accepted,
+            before.calls,
+            before.fifo_scopes,
+            before.fifo_entries
+        ),
+        (
+            after.accepted,
+            after.calls,
+            after.fifo_scopes,
+            after.fifo_entries
+        )
+    );
+    assert!(foreign.check_service_budget(&original).is_ok());
+}
+
+#[test]
+fn canonical_exchange_uses_the_original_service_and_returns_it_to_owner() {
+    let pair = pair();
+    let broker = broker_context().unwrap();
+    let mut original = service_for(&broker);
+    let sender_broker = broker_context().unwrap();
+    let mut sender = Session::new(&pair.sender, &sender_broker).unwrap();
+    let policy = spiralcore_mvm_adapter::Policy::new(
+        pair.receiver.incoming.as_ref().unwrap().context().unwrap(),
+    )
+    .unwrap();
+    let store = tempfile::tempdir().unwrap();
+    let mut object = ObjectMailbox::open(
+        &store.path().join("cache"),
+        Limits::default(),
+        policy,
+        ColdGraphPolicy::Disabled,
+    )
+    .unwrap();
+    let request = Frame {
+        kind: 1,
+        transfer: [59; 32],
+        seq: 0,
+        body: Offer::cold(b"x", Mode::Raw).encode().unwrap(),
+    };
+    let (a, b) = UnixStream::pair().unwrap();
+    let route = pair
+        .sender
+        .outgoing
+        .as_ref()
+        .unwrap()
+        .binding
+        .claims
+        .route_id;
+    let receive_route = pair
+        .receiver
+        .outgoing
+        .as_ref()
+        .unwrap()
+        .binding
+        .claims
+        .route_id;
+    std::thread::scope(|scope| {
+        let mut receiver =
+            Session::with_service(&pair.receiver, &broker, |_| Ok(&mut original)).unwrap();
+        let transfer = request.transfer;
+        let worker = scope.spawn(move || {
+            let stream = StreamTransport::new(b, receive_route, Duration::from_secs(3)).unwrap();
+            let cancel = CancellationToken::default();
+            stream.handshake(HandshakeRole::Acceptor, &cancel).unwrap();
+            receiver
+                .handle(transfer, &mut object, &stream, &cancel)
+                .unwrap()
+        });
+        let stream = StreamTransport::new(a, route, Duration::from_secs(3)).unwrap();
+        let cancel = CancellationToken::default();
+        stream.handshake(HandshakeRole::Initiator, &cancel).unwrap();
+        let (_, reply) = sender.call(&request, &stream, &cancel).unwrap();
+        let handled = worker.join().unwrap();
+        assert_eq!(reply.encode().unwrap(), handled.reply.encode().unwrap());
+    });
+    // Delivery consumes the FIFO entry but preserves its scope and the
+    // accepted identity on the original resident service.
+    let after = original.snapshot();
+    assert_eq!(
+        (after.accepted, after.fifo_scopes, after.fifo_entries),
+        (1, 1, 0)
+    );
+    assert!(broker.check_service_budget(&original).is_ok());
+    broker.with_time(|_, now| original.shutdown(now)).unwrap();
+}
