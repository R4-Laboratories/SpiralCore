+#[test]
+fn replacement_readiness_cannot_refresh_an_expired_exchange_cap() {
+    let pair = fixture_pair();
+    let [socket, peer] = gate::tcp_pair().unwrap();
+    let stream = carrier(socket, &pair.sender);
+    let before = stream.counters().unwrap();
+    let cancel = CancellationToken::default();
+    assert!(matches!(
+        stream.handshake_before(HandshakeRole::Initiator, &cancel, Instant::now()),
+        Err(LiveError::Deadline)
+    ));
+    assert_eq!(json!(stream.counters().unwrap()), json!(before));
+    assert!(matches!(
+        stream.handshake(HandshakeRole::Initiator, &cancel),
+        Err(LiveError::Closed)
+    ));
+    use std::io::Read;
+    assert_eq!((&peer).read(&mut [0]).unwrap(), 0);
+}
+
+#[test]
+fn replacement_is_not_started_without_a_completed_tail() {
+    let pair = fixture_pair();
+    let [old, _old_peer] = gate::tcp_pair().unwrap();
+    let [replacement, _replacement_peer] = gate::tcp_pair().unwrap();
+    let old = carrier(old, &pair.sender);
+    let replacement = carrier(replacement, &pair.sender);
+    let broker = broker_context().unwrap();
+    let mut session = Session::new(&pair.sender, &broker).unwrap();
+    let before = replacement.counters().unwrap();
+    assert_eq!(
+        session
+            .drive_completed_tail_with_fixture_replacement(
+                (&old, &replacement),
+                &CancellationToken::default(),
+                HandshakeRole::Initiator,
+            )
+            .unwrap(),
+        TailDriveOutcome::NoTail
+    );
+    assert_eq!(json!(replacement.counters().unwrap()), json!(before));
+}
