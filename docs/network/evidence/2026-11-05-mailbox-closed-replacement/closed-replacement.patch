@@ -0,0 +1,153 @@
+use super::{reconciliation_tests::gate, *};
+use crate::config::{Arm, Pair, Plan, Stage};
+use cpu_time::ThreadTime;
+use std::net::{Shutdown, TcpStream};
+
+fn carrier(socket: TcpStream, bootstrap: &Bootstrap) -> StreamTransport<TcpStream> {
+    StreamTransport::new(
+        socket,
+        bootstrap.outgoing.as_ref().unwrap().binding.claims.route_id,
+        Duration::from_secs(5),
+    )
+    .unwrap()
+}
+
+#[test]
+fn closed_carrier_replays_only_the_original_reply_and_releases_its_cache() {
+    let wall = Instant::now();
+    let pair = Pair::provision(Plan {
+        stage: Stage::Two,
+        arm: Arm::Raw,
+        size: 4096,
+        trial: 0,
+        bandwidth_profile: Default::default(),
+    })
+    .unwrap();
+    let (a, b, old_gate) = gate::Gate::start_withheld(Some(2), None).unwrap();
+    let (c, d, new_gate) = gate::Gate::start_withheld(None, None).unwrap();
+    let old_state = old_gate.shared();
+    let old_writes = [a.try_clone().unwrap(), b.try_clone().unwrap()];
+    let (a, c) = (carrier(a, &pair.sender), carrier(c, &pair.sender));
+    let (b, d) = (carrier(b, &pair.receiver), carrier(d, &pair.receiver));
+    let mut caller = Session::new(&pair.sender, &broker_context().unwrap()).unwrap();
+    let mut receiver = Session::new(&pair.receiver, &broker_context().unwrap()).unwrap();
+    let store = tempfile::tempdir().unwrap();
+    let policy = spiralcore_mvm_adapter::Policy::new(
+        pair.receiver.incoming.as_ref().unwrap().context().unwrap(),
+    )
+    .unwrap();
+    let mut object = ObjectMailbox::open(
+        &store.path().join("cache"),
+        Limits::default(),
+        policy,
+        ColdGraphPolicy::Disabled,
+    )
+    .unwrap();
+    let request = Frame {
+        kind: 5,
+        transfer: [0; 32],
+        seq: 0,
+        body: vec![],
+    };
+    let expected = request.transfer;
+    let receiver_state = old_state.clone();
+    let (permit, replacement) = std::sync::mpsc::sync_channel(1);
+    let worker = std::thread::spawn(move || {
+        let cpu = ThreadTime::now();
+        let cancel = CancellationToken::default();
+        b.handshake(HandshakeRole::Acceptor, &cancel).unwrap();
+        let handled = receiver
+            .handle_with_fixture_replacement(
+                expected,
+                &mut object,
+                (&b, &d),
+                &cancel,
+                HandshakeRole::Acceptor,
+                replacement,
+            )
+            .unwrap();
+        let call = receiver_state.lock().unwrap().forward.captured[0].clone();
+        let cache_released = receiver
+            .broker
+            .clone()
+            .with_time(|_, now| {
+                receiver
+                    .service
+                    .retry_reply_prepared(&receiver.incoming, &call, now)
+                    .map(|cached| cached.is_none())
+            })
+            .unwrap();
+        assert_eq!(receiver.calls, 1);
+        assert!(cache_released);
+        (
+            handled.reply.encode().unwrap(),
+            [b.counters().unwrap(), d.counters().unwrap()],
+            cpu.elapsed().as_micros(),
+        )
+    });
+
+    let cpu = ThreadTime::now();
+    let cancel = CancellationToken::default();
+    a.handshake(HandshakeRole::Initiator, &cancel).unwrap();
+    let (_, original) = caller
+        .call_with_completed_tail(&request, &a, &cancel, None)
+        .unwrap();
+    assert_eq!(original.kind, 127);
+    assert_eq!(caller.calls, 1);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while old_state.lock().unwrap().forward.withheld.is_none() {
+        assert!(Instant::now() < deadline, "the original ACK did not arrive");
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    for socket in old_writes {
+        socket.shutdown(Shutdown::Write).unwrap();
+    }
+    loop {
+        let state = old_state.lock().unwrap();
+        if state.forward.terminal.is_some() && state.reverse.terminal.is_some() {
+            break;
+        }
+        drop(state);
+        assert!(
+            Instant::now() < deadline,
+            "the old fault gate did not drain"
+        );
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    let old = old_gate.finish().unwrap();
+    assert_eq!(old.forward.terminal.as_deref(), Some("clean EOF"));
+    assert_eq!(old.reverse.terminal.as_deref(), Some("clean EOF"));
+    assert_eq!(old.forward.withheld.as_ref().unwrap().ordinal, 2);
+    assert_eq!(old.forward.written.frames_sent, 1);
+    permit.send(()).unwrap();
+    assert_eq!(
+        caller
+            .drive_completed_tail_with_fixture_replacement(
+                (&a, &c),
+                &cancel,
+                HandshakeRole::Initiator,
+            )
+            .unwrap(),
+        TailDriveOutcome::AckWritten
+    );
+    assert_eq!(caller.calls, 1);
+    let (reply, receiver_counters, receiver_cpu_us) = worker.join().unwrap();
+    assert_eq!(reply, original.encode().unwrap());
+    let new = new_gate.finish().unwrap();
+    assert_eq!(new.forward.read.frames_received, 1, "ACK only, no new Call");
+    assert_eq!(new.reverse.read.frames_received, 1);
+    assert_eq!(new.reverse.captured[0], old.reverse.captured[1]);
+    println!(
+        "{}",
+        json!({
+            "fixture": "one-completed-call-two-loopback-carriers",
+            "exact": true,
+            "caller": [a.counters().unwrap(), c.counters().unwrap()],
+            "receiver": receiver_counters,
+            "withheld_envelope_bytes": old.forward.withheld.unwrap().length,
+            "caller_thread_cpu_us": cpu.elapsed().as_micros(),
+            "receiver_thread_cpu_us": receiver_cpu_us,
+            "total_wall_us": wall.elapsed().as_micros(),
+        })
+    );
+}
