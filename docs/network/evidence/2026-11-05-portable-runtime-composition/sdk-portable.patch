+/// Selected boot evidence handed from the canonical Client bundle resolver.
+#[cfg(unix)]
+pub struct InstalledPortableRuntime {
+    proof: mvm_core::vm_backend::LegacyPortableRuntimeProof,
+    boot_assets: mvm_core::vm_backend::BundleBootAssetsPin,
+    initrd: String,
+    overlay: String,
+    overlay_verity: String,
+    overlay_roothash: String,
+    overlay_version: String,
+}
+
+#[cfg(unix)]
+impl InstalledPortableRuntime {
+    /// Copy only the selected runtime fields. Hostd verifies the evidence again.
+    pub fn from_config(config: &VmStartConfig) -> Result<Self> {
+        Ok(Self {
+            proof: config
+                .legacy_portable_runtime
+                .clone()
+                .context("selected portable proof missing")?,
+            boot_assets: config
+                .bundle_boot_assets
+                .clone()
+                .context("selected portable boot assets missing")?,
+            initrd: config
+                .initrd_path
+                .clone()
+                .context("selected portable initrd missing")?,
+            overlay: config
+                .runtime_overlay_path
+                .clone()
+                .context("selected portable overlay missing")?,
+            overlay_verity: config
+                .runtime_overlay_verity_path
+                .clone()
+                .context("selected portable overlay verity missing")?,
+            overlay_roothash: config
+                .runtime_overlay_roothash
+                .clone()
+                .context("selected portable overlay root hash missing")?,
+            overlay_version: config
+                .runtime_overlay_version
+                .clone()
+                .context("selected portable overlay version missing")?,
+        })
+    }
+
+    fn attach(
+        self,
+        config: &mut VmStartConfig,
+        pin: Option<&mvm_core::plan::PlanArtifact>,
+    ) -> Result<()> {
+        anyhow::ensure!(
+            Some(&self.proof.pin) == pin,
+            "selected portable runtime differs from original admitted bundle"
+        );
+        config.legacy_portable_runtime = Some(self.proof);
+        config.bundle_boot_assets = Some(self.boot_assets);
+        config.initrd_path = Some(self.initrd);
+        config.runtime_overlay_path = Some(self.overlay);
+        config.runtime_overlay_verity_path = Some(self.overlay_verity);
+        config.runtime_overlay_roothash = Some(self.overlay_roothash);
+        config.runtime_overlay_version = Some(self.overlay_version);
+        mvm_runtime::runtime_evidence::verify_runtime_for_launch(
+            config,
+            mvm_runtime::runtime_evidence::MIN_GUEST_RPC_PROTOCOL_VERSION,
+        )?;
+        Ok(())
+    }
+}
