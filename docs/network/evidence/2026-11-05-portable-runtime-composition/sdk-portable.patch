+fn verify_workload_verity_tree(path: &Path, verity: &WorkloadVerity) -> Result<()> {
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt as _;
+        options.custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW);
+    }
+    let file = options
+        .open(path)
+        .context("open selected portable workload verity tree")?;
+    let metadata = file.metadata()?;
+    let signed_len = u64::try_from(verity.tree.len())?;
+    ensure!(
+        metadata.is_file() && metadata.len() == signed_len,
+        "selected portable workload verity tree differs from signed bundle"
+    );
+    let read_limit = signed_len
+        .checked_add(1)
+        .context("portable verity tree length overflow")?;
+    let actual_sha256 = mvm_core::crypto::image_verify::sha256_reader(file.take(read_limit))?;
+    ensure!(
+        actual_sha256 == verity.tree_sha256,
+        "selected portable workload verity tree differs from signed bundle"
+    );
+    Ok(())
+}
