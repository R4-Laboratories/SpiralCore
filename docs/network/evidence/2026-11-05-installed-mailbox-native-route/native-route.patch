+    /// Pin the original native route once, using the already connected API
+    /// socket and the verified Ready identity. The guardian keeps its original
+    /// Child unreaped while its private control pipes remain open.
+    pub fn observe_native_route(&mut self, api: &UnixStream) -> Result<ObservedNativeRoute> {
+        require_owned_child_custody()?;
+        ensure!(
+            !self.stop_started
+                && self.confirmed.is_none()
