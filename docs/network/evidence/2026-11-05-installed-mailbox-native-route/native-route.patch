+#[test]
+fn native_route_observation_requires_exact_peer_and_refuses_dead_original_child() {
+    use std::os::unix::net::UnixListener;
+
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("holders.lock");
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(&path)
+        .unwrap();
+    let meta = file.metadata().unwrap();
+    let output = OutputFile {
+        parent_pid: std::process::id(),
+        fd: file.as_raw_fd(),
+        object: (meta.dev(), meta.ino().checked_add(1).unwrap()),
+        uid: meta.uid(),
+    };
+    let api_path = root.path().join("api.sock");
+    let listener = UnixListener::bind(&api_path).unwrap();
+    listener.set_nonblocking(true).unwrap();
+    let mut config = FcGuardianConfig {
+        binding: fixture_binding(),
+        program: "/not-used-by-owned-fixture".into(),
+        api_socket: api_path.clone(),
+        state_dir: root.path().to_owned(),
+        holder_object: (meta.dev(), meta.ino()),
+        holder_uid: meta.uid(),
+        console: output.clone(),
+        stderr: output,
+    };
+    config.stderr.object.1 = config.stderr.object.1.checked_add(2).unwrap();
+    let child = spawn_fixture_with_peer(&path, Some(&api_path));
+    let cap = Instant::now() + Duration::from_secs(3);
+    let mut launcher = OwnedFcLauncher::start(child, config, cap).unwrap();
+    let accept = || loop {
+        match listener.accept() {
+            Ok((stream, _)) => break stream,
+            Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                assert!(Instant::now() < cap);
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            Err(error) => panic!("accept native fixture peer: {error}"),
+        }
+    };
+    let api = accept();
+    let replacement = accept();
+    let (foreign, _foreign_peer) = UnixStream::pair().unwrap();
+    assert!(launcher.observe_native_route(&foreign).is_err());
+    let observation = launcher.observe_native_route(&api).unwrap();
+    assert!(observation.verify_peer(&fixture_binding(), &api).is_ok());
+    assert!(
+        observation
+            .verify_peer(&fixture_binding(), &replacement)
+            .is_ok()
+    );
+    assert!(
+        observation
+            .verify_peer(&fixture_binding(), &foreign)
+            .is_err()
+    );
+    let mut wrong_binding = fixture_binding();
+    wrong_binding.grant_serial += 1;
+    assert!(observation.verify_peer(&wrong_binding, &api).is_err());
+    assert!(launcher.observe_native_route(&api).is_err());
+
+    api.shutdown(std::net::Shutdown::Write).unwrap();
+    let cap = Instant::now() + Duration::from_secs(2);
+    while observation.verify_peer(&fixture_binding(), &api).is_ok() {
+        assert!(Instant::now() < cap, "the dead child still verifies");
+        std::thread::sleep(Duration::from_millis(1));
+    }
+    assert_eq!(
+        super::super::uds_peer::connected_peer_pid(&api).unwrap(),
+        observation.native_pid,
+        "the original socket still carries its cached peer PID"
+    );
+    assert!(
+        observation
+            .verify_peer(&fixture_binding(), &replacement)
+            .is_err()
+    );
+    assert_eq!(
+        observation.native.wait_event(Instant::now()).unwrap(),
+        ProcessExitWait::Exited
+    );
+    assert!(
+        file.try_lock().is_err(),
+        "guardian still retains the original child"
+    );
+    let exit = launcher
+        .stop(Instant::now() + Duration::from_secs(3))
+        .unwrap();
+    assert_eq!(exit.binding(), &fixture_binding());
+    assert!(launcher.observe_native_route(&api).is_err());
+    assert!(observation.verify_peer(&fixture_binding(), &api).is_err());
+    file.try_lock().unwrap();
+}
