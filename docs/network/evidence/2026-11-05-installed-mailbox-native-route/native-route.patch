+/// A read-only pin of the exact original launcher, native process, and launch
+/// binding. This grants neither guest identity nor permission to accept.
+#[must_use]
+pub struct ObservedNativeRoute {
+    binding: HostLaunchBinding,
+    native_pid: libc::pid_t,
+    native: ProcessExitObserver,
+    launcher: ProcessExitObserver,
+    live: Weak<AtomicBool>,
+}
+
+impl ObservedNativeRoute {
+    pub fn verify_peer(&self, binding: &HostLaunchBinding, stream: &UnixStream) -> Result<()> {
+        let live = self
+            .live
+            .upgrade()
+            .context("original Firecracker route owner dropped")?;
+        ensure!(
+            &self.binding == binding && live.load(Ordering::Acquire),
+            "original Firecracker route binding or lifetime differs"
+        );
+        ensure!(
+            super::uds_peer::connected_peer_pid(stream)? == self.native_pid,
+            "socket peer is not the original Firecracker process"
+        );
+        // A cached numeric credential can outlive an exited peer. Both
+        // process pins must still be live around the peer observation.
+        require_live_pidfd(&self.native)?;
+        require_live_pidfd(&ProcessExitObserver::arm_socket_peer(stream)?)?;
+        require_live_pidfd(&self.native)?;
+        require_live_pidfd(&self.launcher)?;
+        ensure!(
+            live.load(Ordering::Acquire),
+            "original Firecracker route closed"
+        );
+        Ok(())
+    }
+}
+
+fn require_live_pidfd(observer: &ProcessExitObserver) -> Result<()> {
+    ensure!(
+        observer.event_fd().is_some()
+            && observer.wait_event(Instant::now())? == ProcessExitWait::TimedOut,
+        "original Firecracker process observation is no longer live"
+    );
+    Ok(())
 }
 
