+    /// Pin the kernel peer of an already-connected Unix socket. The cached
+    /// peer PID alone cannot safely be reopened after the peer has exited.
+    #[cfg(target_os = "linux")]
+    pub(super) fn arm_socket_peer(
+        socket: &std::os::unix::net::UnixStream,
+    ) -> Result<Self, ProcessExitError> {
+        use std::os::fd::AsRawFd;
+
+        let pid = super::uds_peer::connected_peer_pid(socket).map_err(ProcessExitError::Io)?;
+        let mut fd = -1;
+        let mut len = std::mem::size_of::<libc::c_int>() as libc::socklen_t;
+        // SAFETY: one live Unix socket and writable fd/length storage of the
+        // exact size required by SO_PEERPIDFD. Success transfers an owned fd.
+        let status = unsafe {
+            libc::getsockopt(
+                socket.as_raw_fd(),
+                libc::SOL_SOCKET,
+                libc::SO_PEERPIDFD,
+                (&mut fd as *mut libc::c_int).cast(),
+                &mut len,
+            )
+        };
+        if status != 0 {
+            return Err(ProcessExitError::Io(io::Error::last_os_error()));
+        }
+        if fd < 0 {
+            return Err(ProcessExitError::Unsupported);
+        }
+        let observer = Self {
+            pid,
+            kind: ObserverKind::PidFd { fd },
+        };
+        if len as usize != std::mem::size_of::<libc::c_int>() {
+            return Err(ProcessExitError::Unsupported);
+        }
+        Ok(observer)
+    }
