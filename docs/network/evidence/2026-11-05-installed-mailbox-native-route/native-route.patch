+            super::uds_peer::connected_peer_pid(api)? == native_pid,
+            "Firecracker API peer differs from verified guardian Ready"
+        );
+        let child = self.child.as_mut().context("original launcher missing")?;
+        ensure!(
+            child.try_wait()?.is_none(),
+            "original Firecracker launcher exited"
+        );
+        let launcher = ProcessExitObserver::arm(child.id().try_into()?)?;
+        let native = ProcessExitObserver::arm_socket_peer(api)
+            .context("pin the connected Firecracker API peer pidfd")?;
+        require_live_pidfd(&native)?;
+        require_live_pidfd(&launcher)?;
+        let live = Arc::new(AtomicBool::new(true));
+        let route = ObservedNativeRoute {
+            binding: self.binding.clone(),
+            native_pid,
+            native,
+            launcher,
+            live: Arc::downgrade(&live),
+        };
+        route.verify_peer(&self.binding, api)?;
+        self.route_live = Some(live);
+        Ok(route)
+    }
+
+    fn close_native_route(&self) {
+        if let Some(live) = &self.route_live {
+            live.store(false, Ordering::Release);
+        }
+    }
