+#[test]
+fn finish_receipt_redial_continues_original_object_campaign() {
+    let (commitment, guest, host) = provision_object_recovery().unwrap();
+    assert_ne!(commitment, [0; 32]);
+    let guest = GuestBootstrap::decode(&serde_json::to_vec(&guest).unwrap()).unwrap();
+    let (old_guest, old_host) = UnixStream::pair().unwrap();
+    let (new_guest, new_host) = UnixStream::pair().unwrap();
+    let receiver = campaign::broker_context().unwrap();
+    let mut original = receiver
+        .with_time(|budget, _| LocalMailboxService::new(budget.clone()))
+        .unwrap();
+    let root = tempfile::tempdir().unwrap();
+    let cache = root.path().join("cache");
+    let (sent, received) = std::thread::scope(|scope| {
+        let worker = scope.spawn(|| {
+            host.run_object_campaign_with_redial(
+                old_host,
+                &receiver,
+                &mut original,
+                &cache,
+                Limits::default(),
+                Some(Box::new(move |_| Ok(new_host))),
+            )
+        });
+        let sent = guest.run_object_sender(
+            GuestSocket::new(old_guest).unwrap(),
+            Some(Box::new(move |_| Ok(GuestSocket::new(new_guest)?))),
+            Instant::now() + RECOVERY_CAP,
+        );
+        let received = worker.join().unwrap();
+        (sent.unwrap(), received.unwrap())
+    });
+    let published: Vec<crate::config::Published> =
+        serde_json::from_value(received["published"].clone()).unwrap();
+    campaign::verify(
+        &object_campaign_plan(false),
+        &cache,
+        &published,
+        &mut std::io::sink(),
+    )
+    .unwrap();
+    assert_eq!(published.len(), 7);
+    assert_eq!(sent["service"]["application_calls"], 20);
+    assert_eq!(received["service"]["application_calls"], 20);
+    assert_eq!(original.snapshot().accepted, 20);
+    assert_eq!(original.snapshot().fifo_entries, 0);
+    for (a, b) in [(&sent, &received), (&received, &sent)] {
+        for stem in ["envelope_bytes", "framing_bytes", "frames"] {
+            assert_eq!(
+                a["counters"][format!("{stem}_sent")],
+                b["counters"][format!("{stem}_received")]
