+use super::*;
+
+pub(super) const WINDOW: Duration = Duration::from_secs(8);
+
+pub(super) fn check(cancel: &CancellationToken, cap: Instant) -> Result<()> {
+    use spiralcore_mvm_adapter::service::ServiceError;
+    if cancel.is_cancelled() {
+        return Err(ServiceError::Cancelled.into());
+    }
+    if Instant::now() >= cap {
+        return Err(ServiceError::Expired.into());
+    }
+    Ok(())
+}
+
+pub(crate) type Redial<'a, S> =
+    Box<dyn FnOnce(&CancellationToken, Instant) -> Result<StreamTransport<S>> + 'a>;
+
+pub(super) struct Replacement<'a, S: SocketIo> {
+    dial: Option<Redial<'a, S>>,
+    first: Option<StreamCounters>,
+    next: Option<StreamTransport<S>>,
+}
+
+impl<'a, S: SocketIo + 'static> Replacement<'a, S> {
+    pub(super) fn new(dial: Option<Redial<'a, S>>) -> Self {
+        Self {
+            dial,
+            first: None,
+            next: None,
+        }
+    }
+
+    pub(super) fn pending(&self) -> bool {
+        self.dial.is_some()
+    }
+
+    pub(super) fn first(&self) -> Option<StreamCounters> {
+        self.first
+    }
+
+    pub(super) fn ensure_complete(&self) -> Result<()> {
+        if self.pending() || self.next.is_some() {
+            return Err("required campaign replacement did not complete".into());
+        }
+        Ok(())
+    }
+
+    pub(super) fn initiate(
+        &mut self,
+        old: &StreamTransport<S>,
+        cancel: &CancellationToken,
+        cap: Instant,
+    ) -> Result<&StreamTransport<S>> {
+        check(cancel, cap)?;
+        old.close()?;
+        self.switch(old, cancel, cap)
+    }
+
+    pub(super) fn accept(
+        &mut self,
+        old: &StreamTransport<S>,
+        cancel: &CancellationToken,
+        cap: Instant,
+    ) -> Result<&StreamTransport<S>> {
+        loop {
+            match old.receive_or_idle_observing_eof(cancel, cap, Duration::from_millis(100))? {
+                None => return self.switch(old, cancel, cap),
+                Some(spiralcore_mvm_adapter::live::ReceiveOutcome::Idle) => continue,
+                Some(spiralcore_mvm_adapter::live::ReceiveOutcome::Frame(_)) => {
+                    return Err("unexpected frame before campaign replacement".into());
+                }
+            }
+        }
+    }
+
+    fn switch(
+        &mut self,
+        old: &StreamTransport<S>,
+        cancel: &CancellationToken,
+        cap: Instant,
+    ) -> Result<&StreamTransport<S>> {
+        let dial = self
+            .dial
+            .take()
+            .ok_or("campaign replacement already used")?;
+        let counters = old.counters()?;
+        self.next = Some(dial(cancel, cap)?);
+        self.first = Some(counters);
+        self.next
+            .as_ref()
+            .ok_or_else(|| "campaign replacement missing".into())
+    }
+
+    pub(super) fn install(&mut self, stream: &mut StreamTransport<S>) -> Result<()> {
+        *stream = self.next.take().ok_or("campaign replacement missing")?;
+        Ok(())
+    }
+
+    pub(super) fn install_if_ready(&mut self, stream: &mut StreamTransport<S>) -> Result<()> {
+        if self.next.is_some() {
+            self.install(stream)?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn counters(&self, stream: &StreamTransport<S>) -> Result<StreamCounters> {
+        let current = stream.counters()?;
+        let Some(first) = self.first else {
+            return Ok(current);
+        };
+        let add = |a: u64, b: u64| a.checked_add(b).ok_or("campaign counter overflow");
+        Ok(StreamCounters {
+            envelope_bytes_sent: add(first.envelope_bytes_sent, current.envelope_bytes_sent)?,
+            envelope_bytes_received: add(
+                first.envelope_bytes_received,
+                current.envelope_bytes_received,
+            )?,
+            framing_bytes_sent: add(first.framing_bytes_sent, current.framing_bytes_sent)?,
+            framing_bytes_received: add(
+                first.framing_bytes_received,
+                current.framing_bytes_received,
+            )?,
+            frames_sent: add(first.frames_sent, current.frames_sent)?,
+            frames_received: add(first.frames_received, current.frames_received)?,
+        })
+    }
+}
