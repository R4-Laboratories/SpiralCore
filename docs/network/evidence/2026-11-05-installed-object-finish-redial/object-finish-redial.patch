+    assert_eq!(received["counters"]["frames_sent"], 41);
+    let first = &sent["first_carrier"];
+    assert_eq!(first["frames_sent"], 7);
+    assert_eq!(first["frames_received"], 8);
+    receiver.with_time(|_, now| original.shutdown(now)).unwrap();
+    println!(
+        "{}",
+        serde_json::json!({
+            "sent": sent, "received": received, "verified_objects": published.len()
+        })
+    );
+}
