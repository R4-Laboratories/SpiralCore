+#[test]
+#[cfg(unix)]
+fn partial_old_frame_does_not_open_replacement() {
+    use mvm_core::mailbox::transport::RouteId;
+    use std::cell::Cell;
+    use std::os::unix::net::UnixStream;
+    let route = RouteId::from_bytes([33; 32]);
+    let (guest, host) = UnixStream::pair().unwrap();
+    let mut raw_guest = guest.try_clone().unwrap();
+    let attempts = Cell::new(0);
+    std::thread::scope(|scope| {
+        let worker = scope.spawn(|| {
+            let stream = StreamTransport::new(guest, route, Duration::from_secs(3)).unwrap();
+            stream
+                .handshake(HandshakeRole::Initiator, &CancellationToken::default())
+                .unwrap();
+        });
+        let old = StreamTransport::new(host, route, Duration::from_secs(3)).unwrap();
+        let cancel = CancellationToken::default();
+        old.handshake(HandshakeRole::Acceptor, &cancel).unwrap();
+        worker.join().unwrap();
+        raw_guest.write_all(&[0]).unwrap();
+        raw_guest.shutdown(std::net::Shutdown::Both).unwrap();
+        let redial: Redial<'_, _> = Box::new(|_, _| {
+            attempts.set(attempts.get() + 1);
+            Err("unexpected replacement invocation".into())
+        });
+        let mut replacement = Replacement::new(Some(redial));
+        assert!(
+            replacement
+                .accept(&old, &cancel, Instant::now() + WINDOW)
+                .is_err()
+        );
+        assert!(replacement.first().is_none());
+    });
+    assert_eq!(attempts.get(), 0);
+}
