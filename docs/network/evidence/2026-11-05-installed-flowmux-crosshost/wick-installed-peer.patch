+fn read_control<T: serde::de::DeserializeOwned>(path: &Path) -> Result<T> {
+    use std::os::unix::fs::MetadataExt as _;
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW)
+        .open(path)?;
+    let metadata = file.metadata()?;
+    mvm_core::private_fs::require_current_owner(&metadata)?;
+    ensure!(
+        metadata.is_file()
+            && metadata.mode() & 0o7777 == 0o600
+            && metadata.nlink() == 1
+            && metadata.len() <= 4096
+    );
+    let mut bytes = Vec::new();
+    file.take(4097).read_to_end(&mut bytes)?;
+    ensure!(bytes.len() <= 4096);
+    Ok(serde_json::from_slice(&bytes)?)
+}
+
+fn wait_for<T>(until: Instant, mut open: impl FnMut() -> Result<T>) -> Result<T> {
+    loop {
+        ensure!(
+            Instant::now() < until,
+            "remote FlowMux control deadline expired"
+        );
+        match open() {
+            Ok(value) => return Ok(value),
+            Err(error)
+                if error
+                    .downcast_ref::<std::io::Error>()
+                    .is_some_and(|error| error.kind() == ErrorKind::NotFound) =>
+            {
+                thread::sleep(Duration::from_millis(10))
+            }
+            Err(error) => return Err(error),
+        }
+    }
+}
