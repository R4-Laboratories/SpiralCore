+#[derive(serde::Deserialize)]
+struct RemoteOutcome {
+    event: String,
+    control_id: [u8; 32],
+    peer: SocketAddr,
+    listener: SocketAddr,
+    peer_store_removed: bool,
+    setup_artifacts_exact: bool,
+    result: NativePeerResult,
+}
+
+fn serve_remote(
+    root: &Path,
+    control_id: [u8; 32],
+    origin: Ipv4Addr,
+    address: SocketAddr,
+    peer_spki: [u8; 32],
+    plan: &AdmittedNetworkPlan,
+    state: &Path,
+    session: [u8; 32],
+    host_spki: [u8; 32],
+    until: Instant,
+) -> Result<NativePeerResult> {
+    let session = spiralcore_transfer::hex(&session);
+    let guest_key = wait_for(until, || read_original_identity(state, &session))?;
+    let transfer_deadline = until.min(Instant::now() + Duration::from_secs(20));
+    let remaining = transfer_deadline.saturating_duration_since(Instant::now());
+    ensure!(!remaining.is_zero());
+    let expires_unix_ms = (SystemTime::now().duration_since(UNIX_EPOCH)? + remaining).as_millis();
+    let projection = serde_json::json!({
+        "control_id":control_id, "listener":address, "peer_spki":peer_spki, "host_spki":host_spki,
+        "policy_sha256":digest::<32>(&plan.policy_sha256)?,
+        "plan_id":plan.plan_id.0, "plan_version":plan.plan_version,
+        "plan_nonce":digest::<16>(plan.plan_nonce.as_hex())?,
+        "bundle_sha256":digest::<32>(&plan.bundle_sha256)?,
+        "tenant":plan.tenant_id, "instance":plan.instance_id,
+        "session":session, "guest_key":guest_key, "expires_unix_ms":expires_unix_ms
+    });
+    let bytes = serde_json::to_vec(&projection)?;
+    ensure!(bytes.len() < 4096);
+    let temporary = root.join("flowmux-scope.tmp");
+    let mut output = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(&temporary)?;
+    output.write_all(&bytes)?;
+    output.write_all(b"\n")?;
+    drop(output);
+    std::fs::rename(temporary, root.join("flowmux-scope.json"))?;
+    let report: RemoteOutcome = wait_for(transfer_deadline, || {
+        read_control(&root.join("flowmux-result.json"))
+    })?;
+    ensure!(
+        report.event == "done"
+            && report.control_id == control_id
+            && report.listener == address
+            && report.peer.ip() == std::net::IpAddr::V4(origin)
+            && report.peer_store_removed
+            && report.setup_artifacts_exact
+    );
+    let expected = b"{\"kind\":\"flowmux\",\"value\":1}\n".repeat(REPETITIONS);
+    ensure!(
+        report.result.received_bytes == expected.len()
+            && report.result.sent_bytes == expected.len()
+            && report.result.payload_sha256 == hex::encode(Sha256::digest(&expected))
+            && digest::<32>(&report.result.scope_commitment)? != [0; 32]
+            && report.result.tls_received_bytes > 0
+            && report.result.tls_sent_bytes > 0
+            && report.result.process_cpu_ns.is_some()
+    );
+    Ok(report.result)
+}
