+#[cfg(test)]
+#[test]
+fn early_recovery_wake_failure_does_not_skip_original_native_stop() {
+    use super::super::{NoopConsoleStreamer, VmId};
+    use super::{InstalledSlots, NativeDispatch, Ordering, retirement_tests::owner};
+    use mvm_core::vm_backend::{VmExitStatus, VmStatus};
+    use mvm_vmm::driver::traits::{DuplexStream, RunningVm};
+
+    struct StopProbe(VmId);
+    impl RunningVm for StopProbe {
+        fn id(&self) -> &VmId {
+            &self.0
+        }
+        fn wait(&self) -> anyhow::Result<VmExitStatus> {
+            unreachable!()
+        }
+        fn kill(&self) -> anyhow::Result<()> {
+            anyhow::bail!("original native stop probe reached")
+        }
+        fn pause(&self) -> anyhow::Result<()> {
+            unreachable!()
+        }
+        fn resume(&self) -> anyhow::Result<()> {
+            unreachable!()
+        }
+        fn status(&self) -> anyhow::Result<VmStatus> {
+            unreachable!()
+        }
+        fn vsock_connect(&self, _: u32) -> anyhow::Result<Box<dyn DuplexStream>> {
+            unreachable!()
+        }
+    }
+
+    let table = InstalledSlots::default();
+    let (_root, anchor, _) = owner("recovery-wake-failure", 91);
+    let slot = table.reserve(&anchor).unwrap();
+    slot.dispatch
+        .store(NativeDispatch::AttemptedTerminal as u8, Ordering::Release);
+    let control = Arc::new(Mutex::new(Control::default()));
+    let _ = std::panic::catch_unwind(|| {
+        let _held = control.lock().unwrap();
+        panic!("injected recovery wake poison");
+    });
+    assert!(control.is_poisoned());
+    assert!(
+        slot.mailbox_stop
+            .set(MailboxStop(Arc::downgrade(&control)))
+            .is_ok()
+    );
+    slot.retain_vm(Box::new(StopProbe(VmId(anchor.binding().vm_name.clone()))))
+        .unwrap();
+    let error = slot.stop(&NoopConsoleStreamer).unwrap_err();
+    assert_eq!(error.to_string(), "original native stop probe reached");
+    assert!(table.take_retired(&slot).is_err());
+}
