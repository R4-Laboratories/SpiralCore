 struct Control {
     stopped: bool,
     accepted: Option<UnixStream>,
+    wake: Option<UnixStream>,
+    recovery_route: Option<Weak<dyn InstalledMailboxRecoveryRoute>>,
+    replacement_started: bool,
+}
+
+impl Control {
+    fn signal_stop(&mut self) -> io::Result<()> {
+        self.stopped = true;
+        self.recovery_route.take();
+        let wake = self
+            .wake
+            .as_ref()
+            .map_or(Ok(()), |s| shutdown(s, Shutdown::Write));
+        let accepted = self
+            .accepted
+            .as_ref()
+            .map_or(Ok(()), |s| shutdown(s, Shutdown::Both));
+        wake.and(accepted)
+    }
+
+    fn publish_route(&mut self, route: Weak<dyn InstalledMailboxRecoveryRoute>) -> io::Result<()> {
+        if self.stopped || self.replacement_started || self.recovery_route.is_some() {
+            return Err(io::Error::other(
+                "original mailbox recovery publication refused",
+            ));
+        }
+        self.recovery_route = Some(route);
+        Ok(())
+    }
+
+    fn begin_replacement(&mut self) -> io::Result<Weak<dyn InstalledMailboxRecoveryRoute>> {
+        if std::mem::replace(&mut self.replacement_started, true) || self.stopped {
+            return Err(io::Error::other(
+                "original mailbox replacement attempt unavailable",
+            ));
+        }
+        let route = self
+            .recovery_route
+            .take()
+            .ok_or_else(|| io::Error::other("original mailbox recovery route unpublished"))?;
+        let old = self
+            .accepted
+            .take()
+            .ok_or_else(|| io::Error::other("original accepted mailbox socket unavailable"))?;
+        shutdown(&old, Shutdown::Both)?;
+        Ok(route)
+    }
 }
 
