+#[cfg(test)]
+mod replacement_control_tests {
+    use super::*;
+
+    struct Route;
+    impl InstalledMailboxRecoveryRoute for Route {
+        fn verify_route(&self, _: &HostLaunchBinding, _: &Path) -> anyhow::Result<()> {
+            unreachable!("these tests exercise Runtime control only")
+        }
+
+        fn verify_peer(&self, _: &HostLaunchBinding, _: &UnixStream) -> anyhow::Result<()> {
+            unreachable!("these tests exercise Runtime control only")
+        }
+    }
+
+    #[test]
+    fn replacement_before_successful_launch_consumes_the_attempt() {
+        let route: Arc<dyn InstalledMailboxRecoveryRoute> = Arc::new(Route);
+        let mut control = Control::default();
+        assert!(control.begin_replacement().is_err());
+        assert!(control.publish_route(Arc::downgrade(&route)).is_err());
+        assert!(control.begin_replacement().is_err());
+    }
+
+    #[test]
+    fn replacement_retires_the_old_socket_and_takes_one_attempt() {
+        use std::io::Read as _;
+        let route: Arc<dyn InstalledMailboxRecoveryRoute> = Arc::new(Route);
+        let (old, mut peer) = UnixStream::pair().unwrap();
+        peer.set_read_timeout(Some(Duration::from_secs(1))).unwrap();
+        let mut control = Control {
+            accepted: Some(old),
+            ..Control::default()
+        };
+        control.publish_route(Arc::downgrade(&route)).unwrap();
+        assert!(control.begin_replacement().unwrap().upgrade().is_some());
+        assert_eq!(peer.read(&mut [0]).unwrap(), 0);
+        assert!(control.begin_replacement().is_err());
+        assert!(control.publish_route(Arc::downgrade(&route)).is_err());
+    }
+
+    #[test]
+    fn stop_closes_the_accepted_socket_and_refuses_recovery() {
+        use std::io::Read as _;
+        let route: Arc<dyn InstalledMailboxRecoveryRoute> = Arc::new(Route);
+        let (old, mut peer) = UnixStream::pair().unwrap();
+        let (wake, mut waiter) = UnixStream::pair().unwrap();
+        peer.set_read_timeout(Some(Duration::from_secs(1))).unwrap();
+        waiter
+            .set_read_timeout(Some(Duration::from_secs(1)))
+            .unwrap();
+        let mut control = Control {
+            accepted: Some(old),
+            wake: Some(wake),
+            ..Control::default()
+        };
+        control.publish_route(Arc::downgrade(&route)).unwrap();
+        control.signal_stop().unwrap();
+        assert_eq!(peer.read(&mut [0]).unwrap(), 0);
+        assert_eq!(waiter.read(&mut [0]).unwrap(), 0);
+        assert!(control.begin_replacement().is_err());
+    }
+}
