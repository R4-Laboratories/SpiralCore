+impl InstalledMailboxReplacementAcceptor for Replacement<'_> {
+    fn accept_after_clean_close(&mut self, deadline: Instant) -> io::Result<UnixStream> {
+        let route = self
+            .control
+            .lock()
+            .map_err(|_| io::Error::other("mailbox control poisoned"))?
+            .begin_replacement()?;
+        {
+            let route = route.upgrade().ok_or_else(recovery_route_expired)?;
+            route
+                .verify_route(self.binding, self.readiness.verify_original_identity()?)
+                .map_err(io::Error::other)?;
+        }
+        let socket = loop {
+            if !wait_for_peer(
+                self.listener.as_raw_fd(),
+                self.wake.as_raw_fd(),
+                Some(deadline),
+            )? {
+                return Err(io::Error::new(
+                    io::ErrorKind::Interrupted,
+                    "original mailbox stopped",
+                ));
+            }
+            let state = self
+                .control
+                .lock()
+                .map_err(|_| io::Error::other("mailbox control poisoned"))?;
+            check_replacement_window(&state, deadline)?;
+            // The listener remains nonblocking. Stop shares this lock, so
+            // its latch cannot race a subsequent accept or publication.
+            match self.listener.accept() {
+                Ok((socket, _)) => break socket,
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => continue,
+                Err(error) => return Err(error),
+            }
+        };
+        {
+            let route = route.upgrade().ok_or_else(recovery_route_expired)?;
+            route
+                .verify_peer(self.binding, &socket)
+                .map_err(io::Error::other)?;
+            route
+                .verify_route(self.binding, self.readiness.verify_original_identity()?)
+                .map_err(io::Error::other)?;
+        }
+        socket.set_nonblocking(false)?;
+        let shutdown_socket = socket.try_clone()?;
+        let mut state = self
+            .control
+            .lock()
+            .map_err(|_| io::Error::other("mailbox control poisoned"))?;
+        check_replacement_window(&state, deadline)?;
+        state.accepted = Some(shutdown_socket);
+        Ok(socket)
+    }
+}
+
+fn check_replacement_window(state: &Control, deadline: Instant) -> io::Result<()> {
+    if state.stopped {
+        return Err(io::Error::new(
+            io::ErrorKind::Interrupted,
+            "original mailbox stopped",
