+#[test]
+fn native_receipt_accepts_bounded_sender_clock_ahead_without_relaxing_validation() {
+    use super::{CONTENT_TYPE, HandshakeRole, MessageOptions, Peer, campaign, service_sender};
+    use mvm_contract::protocol::mailbox::ContentType;
+    use mvm_core::mailbox::encode_envelope;
+    use spiralcore_mvm_adapter::service::{LocalMailboxService, ServiceTime};
+    use std::sync::mpsc::sync_channel;
+
+    let (_, guest, host) = mailbox_witness::provision().unwrap();
+    let broker = campaign::broker_context().unwrap();
+    let host_now = broker
+        .with_time(|_, now| Ok::<_, Box<dyn std::error::Error + Send + Sync>>(now))
+        .unwrap();
+    let guest_now = ServiceTime {
+        unix_ms: host_now.unix_ms - 1_000,
+        ..host_now
+    };
+    let (a, b) = UnixStream::pair().unwrap();
+    let (call_tx, call_rx) = sync_channel::<Vec<u8>>(1);
+    let worker = std::thread::spawn(move || {
+        let broker = campaign::broker_context().unwrap();
+        let mut service = broker
+            .with_time(|budget, _| LocalMailboxService::new(budget.clone()))
+            .unwrap();
+        let peer = Peer::open(&host.endpoint, &broker, a, HandshakeRole::Acceptor).unwrap();
+        let call = call_rx.recv_timeout(super::TIMEOUT).unwrap();
+        let (_, receipt) = peer
+            .returns
+            .admit(&mut service, &peer.incoming, &call, host_now)
+            .unwrap();
+        receipt.encoded_bytes().to_vec()
+    });
+    let peer = Peer::open(&guest.endpoint, &broker, b, HandshakeRole::Initiator).unwrap();
+    let mut tracker = peer.tracker().unwrap();
+    let mut options = MessageOptions::fresh(
+        ContentType::parse(CONTENT_TYPE, 1).unwrap(),
+        guest_now,
+        guest_now.unix_ms + 10_000,
+    )
+    .unwrap();
+    options.reply_to = guest.endpoint.outgoing.as_ref().unwrap().reply_to;
+    let prepared = service_sender::prepare(&peer.outgoing, b"skew", &options, guest_now).unwrap();
+    let wire = encode_envelope(prepared.envelope()).unwrap();
+    let send = tracker
+        .register_send(
+            &peer.outgoing,
+            &peer.control,
+            &peer.verifier,
+            &wire,
+            guest_now,
+        )
+        .unwrap();
+    call_tx.send(wire).unwrap();
+    let receipt = worker.join().unwrap();
+    let beyond_bound = ServiceTime {
+        unix_ms: host_now.unix_ms - 6_000,
+        ..guest_now
+    };
+    assert_eq!(
+        tracker.observe_receipt(&peer.control, &receipt, beyond_bound),
+        Err(spiralcore_mvm_adapter::service::ServiceError::Unauthorized)
+    );
+    assert!(matches!(
+        tracker
+            .take_receipt(&peer.outgoing, &send, beyond_bound)
+            .unwrap(),
+        super::ReceiptObservation::Pending
+    ));
+    tracker
+        .observe_receipt(&peer.control, &receipt, guest_now)
+        .expect("signed receipt from an endpoint one second ahead");
+    assert!(matches!(
+        tracker
+            .take_receipt(&peer.outgoing, &send, guest_now)
+            .unwrap(),
+        super::ReceiptObservation::Verified(_)
+    ));
+}
