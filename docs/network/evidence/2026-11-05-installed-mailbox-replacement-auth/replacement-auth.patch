+    /// Prove the enrolled peer on this exact recovery socket before framing
+    /// any mailbox envelopes. Both ends supply an independently selected
+    /// recovery session ID bound to the original launch and authorization.
+    /// Handshake traffic counts as framing bytes. Mailbox envelopes continue
+    /// to use their existing end-to-end encryption and authentication.
+    pub fn authenticate_replacement(
+        &self,
+        identity: ReplacementIdentity<'_>,
+        original_session: &str,
+        cancel: &CancellationToken,
+        deadline: Instant,
+    ) -> LiveResult<()> {
+        use mvm_core::net::session::Session;
+
+        let deadline = deadline.min(Instant::now() + self.timeout);
+        let mut state = lock(&self.state, cancel, deadline)?;
+        if state.closed || state.ready {
+            return Err(LiveError::Closed);
+        }
+        let StreamState {
+            socket, counters, ..
+        } = &mut *state;
+        let mut io = ReplacementIo {
+            socket,
+            counters,
+            cancel,
+            deadline,
+        };
+        let handshake = match identity {
+            ReplacementIdentity::Host {
+                signing_key,
+                expected_guest,
+            } => Session::host_for_peer(
+                &mut io,
+                original_session,
+                signing_key.clone(),
+                expected_guest,
+            ),
+            ReplacementIdentity::Guest {
+                signing_key,
+                expected_host,
+            } => Session::guest_for_session(
+                &mut io,
+                signing_key.clone(),
+                expected_host,
+                original_session,
+            ),
+        };
+        let result = remaining(cancel, deadline)
+            .and_then(|_| handshake.map(drop).map_err(LiveError::Authentication));
+        state.closed = result.is_err();
+        state.ready = result.is_ok();
+        if result.is_err() {
+            shutdown_both(&state.socket);
+        }
+        result
+    }
