+#![cfg(all(feature = "live", unix))]
+
+mod common;
+use ed25519_dalek::SigningKey;
+use mvm_contract::protocol::mailbox::MailboxMessageKind;
+use mvm_core::{mailbox::transport::CancellationToken, net::session::SessionError};
+use spiralcore_mvm_adapter::live::{LiveError, ReplacementIdentity, StreamTransport};
+use std::{
+    os::unix::net::UnixStream,
+    time::{Duration, Instant},
+};
+
+const SESSION: &str = "installed-mailbox-v2/fixture/launch-1/route-1";
+
+fn carrier(socket: UnixStream) -> StreamTransport<UnixStream> {
+    let route = common::config(MailboxMessageKind::Call)
+        .binding
+        .claims
+        .route_id;
+    StreamTransport::new(socket, route, Duration::from_secs(2)).unwrap()
+}
+
+#[test]
+fn exact_pins_prove_both_peers_on_the_same_socket_and_count_wire_bytes() {
+    let (a, b) = UnixStream::pair().unwrap();
+    let host = carrier(a);
+    let guest = carrier(b);
+    let host_key = SigningKey::from_bytes(&[1; 32]);
+    let guest_key = SigningKey::from_bytes(&[2; 32]);
+    let deadline = Instant::now() + Duration::from_secs(2);
+    let cancel = CancellationToken::default();
+    std::thread::scope(|scope| {
+        let server = scope.spawn(|| {
+            host.authenticate_replacement(
+                ReplacementIdentity::Host {
+                    signing_key: &host_key,
+                    expected_guest: &guest_key.verifying_key(),
+                },
+                SESSION,
+                &cancel,
+                deadline,
+            )
+        });
+        guest
+            .authenticate_replacement(
+                ReplacementIdentity::Guest {
+                    signing_key: &guest_key,
+                    expected_host: &host_key.verifying_key(),
+                },
+                SESSION,
+                &cancel,
+                deadline,
+            )
+            .unwrap();
+        server.join().unwrap().unwrap();
+    });
+    let h = host.counters().unwrap();
+    let g = guest.counters().unwrap();
+    assert!(h.framing_bytes_sent > 8 && h.framing_bytes_received > 8);
+    assert_eq!(h.framing_bytes_sent, g.framing_bytes_received);
+    assert_eq!(h.framing_bytes_received, g.framing_bytes_sent);
+    assert_eq!((h.frames_sent, g.frames_sent), (0, 0));
+}
+
+#[test]
+fn valid_but_unenrolled_guest_is_refused_and_carrier_fenced() {
+    let (a, b) = UnixStream::pair().unwrap();
+    let host = carrier(a);
+    let guest = carrier(b);
+    let host_key = SigningKey::from_bytes(&[1; 32]);
+    let guest_key = SigningKey::from_bytes(&[2; 32]);
+    let enrolled = SigningKey::from_bytes(&[3; 32]).verifying_key();
+    let deadline = Instant::now() + Duration::from_secs(2);
+    let cancel = CancellationToken::default();
+    std::thread::scope(|scope| {
+        let server = scope.spawn(|| {
+            host.authenticate_replacement(
+                ReplacementIdentity::Host {
+                    signing_key: &host_key,
+                    expected_guest: &enrolled,
+                },
+                SESSION,
+                &cancel,
+                deadline,
+            )
+        });
+        assert!(
+            guest
+                .authenticate_replacement(
+                    ReplacementIdentity::Guest {
+                        signing_key: &guest_key,
+                        expected_host: &host_key.verifying_key()
+                    },
+                    SESSION,
+                    &cancel,
+                    deadline,
+                )
+                .is_err()
+        );
+        assert!(matches!(
+            server.join().unwrap(),
+            Err(LiveError::Authentication(
+                SessionError::PeerIdentityMismatch(_)
+            ))
+        ));
+    });
+    assert!(matches!(
+        host.receive(&cancel, deadline),
+        Err(LiveError::Closed)
+    ));
+    assert_eq!(host.counters().unwrap().frames_sent, 0);
+}
+
+#[test]
+fn guest_rejects_wrong_session_before_sending_any_proof() {
+    let (a, b) = UnixStream::pair().unwrap();
+    let host = carrier(a);
+    let guest = carrier(b);
+    let host_key = SigningKey::from_bytes(&[1; 32]);
+    let guest_key = SigningKey::from_bytes(&[2; 32]);
+    let deadline = Instant::now() + Duration::from_secs(2);
+    let cancel = CancellationToken::default();
+    std::thread::scope(|scope| {
+        let server = scope.spawn(|| {
+            host.authenticate_replacement(
+                ReplacementIdentity::Host {
+                    signing_key: &host_key,
+                    expected_guest: &guest_key.verifying_key(),
+                },
+                "other-session",
+                &cancel,
+                deadline,
+            )
+        });
+        assert!(matches!(
+            guest.authenticate_replacement(
+                ReplacementIdentity::Guest {
+                    signing_key: &guest_key,
+                    expected_host: &host_key.verifying_key()
+                },
+                SESSION,
+                &cancel,
+                deadline,
+            ),
+            Err(LiveError::Authentication(
+                SessionError::InvalidHandshake(reason)
+            )) if reason == "host session does not match the authorized identity"
+        ));
+        assert!(server.join().unwrap().is_err());
+    });
+    assert_eq!(guest.counters().unwrap().framing_bytes_sent, 0);
+}
+
+#[test]
+fn silent_peer_cannot_extend_original_deadline() {
+    let (a, _silent) = UnixStream::pair().unwrap();
+    let host = carrier(a);
+    let host_key = SigningKey::from_bytes(&[1; 32]);
+    let guest_key = SigningKey::from_bytes(&[2; 32]).verifying_key();
+    let start = Instant::now();
+    let cancel = CancellationToken::default();
+    assert!(matches!(
+        host.authenticate_replacement(
+            ReplacementIdentity::Host {
+                signing_key: &host_key,
+                expected_guest: &guest_key
+            },
+            SESSION,
+            &cancel,
+            start + Duration::from_millis(80),
+        ),
+        Err(LiveError::Deadline)
+    ));
+    assert!(start.elapsed() < Duration::from_secs(1));
+    assert!(matches!(
+        host.receive(&cancel, Instant::now() + Duration::from_secs(1)),
+        Err(LiveError::Closed)
+    ));
+}
+
+#[test]
+fn cancellation_interrupts_authentication_after_hello_has_started() {
+    use std::io::Read as _;
+    let (a, mut silent) = UnixStream::pair().unwrap();
+    silent
+        .set_read_timeout(Some(Duration::from_secs(2)))
+        .unwrap();
+    let host = carrier(a);
+    let host_key = SigningKey::from_bytes(&[1; 32]);
+    let guest_key = SigningKey::from_bytes(&[2; 32]).verifying_key();
+    let deadline = Instant::now() + Duration::from_secs(2);
+    let cancel = CancellationToken::default();
+    std::thread::scope(|scope| {
+        let server = scope.spawn(|| {
+            host.authenticate_replacement(
+                ReplacementIdentity::Host {
+                    signing_key: &host_key,
+                    expected_guest: &guest_key,
+                },
+                SESSION,
+                &cancel,
+                deadline,
+            )
+        });
+        silent.read_exact(&mut [0; 4]).unwrap();
+        cancel.cancel();
+        assert!(matches!(server.join().unwrap(), Err(LiveError::Cancelled)));
+    });
+    assert!(matches!(
+        host.receive(&CancellationToken::default(), deadline),
+        Err(LiveError::Closed),
+    ));
+}
