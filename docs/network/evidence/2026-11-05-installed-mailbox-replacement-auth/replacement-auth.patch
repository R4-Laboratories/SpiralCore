+/// Independently enrolled local and peer keys for the original recovery session.
+pub enum ReplacementIdentity<'a> {
+    Host {
+        signing_key: &'a ed25519_dalek::SigningKey,
+        expected_guest: &'a ed25519_dalek::VerifyingKey,
+    },
+    Guest {
+        signing_key: &'a ed25519_dalek::SigningKey,
+        expected_host: &'a ed25519_dalek::VerifyingKey,
+    },
+}
+
+struct ReplacementIo<'a, S> {
+    socket: &'a mut S,
+    counters: &'a mut StreamCounters,
+    cancel: &'a CancellationToken,
+    deadline: Instant,
+}
+
+impl<S> ReplacementIo<'_, S> {
+    fn timeout(&self) -> io::Result<Duration> {
+        remaining(self.cancel, self.deadline).map_err(io::Error::other)
+    }
+
+    fn retry(error: &io::Error) -> bool {
+        matches!(
+            error.kind(),
+            io::ErrorKind::Interrupted | io::ErrorKind::WouldBlock | io::ErrorKind::TimedOut
+        )
+    }
+}
+
+impl<S: SocketIo> Read for ReplacementIo<'_, S> {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        loop {
+            self.socket.set_read_timeout(Some(self.timeout()?))?;
+            match self.socket.read(buf) {
+                Ok(count) => {
+                    increment(&mut self.counters.framing_bytes_received, count)
+                        .map_err(io::Error::other)?;
+                    return Ok(count);
+                }
+                Err(error) if Self::retry(&error) => {}
+                Err(error) => return Err(error),
+            }
+        }
+    }
+}
+
+impl<S: SocketIo> Write for ReplacementIo<'_, S> {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        loop {
+            self.socket.set_write_timeout(Some(self.timeout()?))?;
+            match self.socket.write(buf) {
+                Ok(count) => {
+                    increment(&mut self.counters.framing_bytes_sent, count)
+                        .map_err(io::Error::other)?;
+                    return Ok(count);
+                }
+                Err(error) if Self::retry(&error) => {}
+                Err(error) => return Err(error),
+            }
+        }
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.socket.set_write_timeout(Some(self.timeout()?))?;
+        self.socket.flush()
+    }
+}
