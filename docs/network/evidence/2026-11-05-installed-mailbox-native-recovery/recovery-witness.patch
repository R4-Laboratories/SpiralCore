+
+#[test]
+fn caller_can_abandon_after_authenticated_call_receipt_without_reply() {
+    let (_, guest, host) = super::provision_with_close(true).unwrap();
+    let (a, b) = UnixStream::pair().unwrap();
+    let worker = std::thread::spawn(move || {
+        let broker = crate::campaign::broker_context().unwrap();
+        let mut service = broker
+            .with_time(|budget, _| {
+                spiralcore_mvm_adapter::service::LocalMailboxService::new(budget.clone())
+            })
+            .unwrap();
+        host.run(a, &broker, &mut service).unwrap()
+    });
+    let encoded = serde_json::to_vec(&guest).unwrap();
+    let guest = super::GuestBootstrap::decode(&encoded).unwrap();
+    assert!(guest.close_after_call_receipt);
+    let client = guest.exchange(b).unwrap();
+    let server = worker.join().unwrap();
+    for result in [&client, &server] {
+        assert_eq!(
+            (result.call_bytes, result.reply_bytes, result.cast_bytes),
+            (65_023, 0, 0)
+        );
+        assert_eq!(
+            (result.counters.frames_sent, result.counters.frames_received),
+            (1, 1)
+        );
+    }
+    assert_eq!(
+        client.counters.envelope_bytes_sent,
+        server.counters.envelope_bytes_received
+    );
+    assert_eq!(
+        client.counters.envelope_bytes_received,
+        server.counters.envelope_bytes_sent
+    );
+}
