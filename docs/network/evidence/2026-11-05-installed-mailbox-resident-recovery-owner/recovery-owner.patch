+#[cfg(all(target_os = "linux", target_pointer_width = "64"))]
+struct ResidentRecoveryAcceptor<'a> {
+    grant: &'a VmGrant,
+    plan: &'a PlanId,
+    enrollment: [u8; 32],
+    acceptor: &'a mut dyn mvm_core::host_lifetime::InstalledMailboxReplacementAcceptor,
