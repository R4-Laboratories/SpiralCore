+#[cfg(all(target_os = "linux", target_pointer_width = "64"))]
+#[test]
+fn recovery_job_uses_only_its_original_enrolled_parent_and_funding() {
+    use mvm_core::host_lifetime::InstalledMailboxReplacementAcceptor;
+    use std::{
+        io::{self, Read, Write},
+        net::Shutdown,
+        os::unix::net::UnixStream,
+        time::{Duration, Instant},
+    };
+
+    struct OneRedial {
+        socket: Option<UnixStream>,
+        deadline: Instant,
+    }
+    impl InstalledMailboxReplacementAcceptor for OneRedial {
+        fn accept_after_clean_close(&mut self, deadline: Instant) -> io::Result<UnixStream> {
+            assert_eq!(deadline, self.deadline);
+            self.socket
+                .take()
+                .ok_or_else(|| io::Error::other("fixture attempt used"))
+        }
+    }
+
+    let (home, supervisor, provider) = endpoint_tests::fixture();
+    let name = "signed-recovery-original-owner";
+    let trusted = InstalledMailboxEnrollment::new([94; 32]).unwrap();
+    let admitted = admitted_with_profile(
+        home.path(),
+        name,
+        Some(InstalledMailboxLaunchProfile::LinuxFirecrackerRecoveryV2),
+        Some(trusted),
+    );
+    let prepared = prepared_vm(&provider, name);
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let (notified, completed) = std::sync::mpsc::sync_channel(1);
+    prepared
+        .stage_mailbox_recovery_enrollment_fixture(
+            &admitted,
+            trusted,
+            move |mut old, acceptor, _, _| {
+                assert_eq!(old.read(&mut [0])?, 0);
+                drop(old);
+                let mut socket = acceptor.accept_after_clean_close(deadline)?;
+                let mut bytes = [0; 4];
+                socket.read_exact(&mut bytes)?;
+                assert_eq!(&bytes, b"same");
+                notified.send(()).unwrap();
+                Ok(())
+            },
+        )
+        .unwrap();
+    let (grant, mut config) = config_for_prepared(prepared, name);
+    config.plan_json = Some(serde_json::to_string(admitted.signed()).unwrap());
+    provider
+        .check_installed_mailbox_enrollment(&admitted, &config, native_backend())
+        .unwrap();
+    let permit = provider
+        .bind_config(&admitted, &config, native_backend())
+        .unwrap();
+    let anchor = config.host_lifetime.as_ref().unwrap();
+    anchor
+        .bind_parent_permit(&config, native_backend(), permit.clone())
+        .unwrap();
+    assert!(
+        anchor
+            .prepare_installed_mailbox(&config, native_backend())
+            .is_err()
+    );
+    assert!(
+        anchor
+            .prepare_recovery_installed_mailbox(&config, native_backend(), [95; 32])
+            .is_err()
+    );
+    anchor
+        .prepare_recovery_installed_mailbox(&config, native_backend(), trusted.digest())
+        .unwrap();
+    assert!(
+        permit
+            .check_native_mailbox_claim(&grant.binding, admitted.plan_id())
+            .is_err()
+    );
+    assert!(
+        permit
+            .check_native_mailbox_recovery(&grant.binding, admitted.plan_id(), [95; 32])
+            .is_err()
+    );
+    permit
+        .check_native_mailbox_recovery(&grant.binding, admitted.plan_id(), trusted.digest())
+        .unwrap();
+
+    let mut handoff = anchor
+        .take_installed_mailbox(&config, native_backend())
+        .unwrap()
+        .unwrap();
+    assert!(handoff.take_socket_job().is_err());
+    let job = handoff.take_bound_socket_job().unwrap();
+    assert_eq!(job.recovery_enrollment(), Some(trusted.digest()));
+    assert!(handoff.take_bound_socket_job().is_err());
+    let (socket, peer) = UnixStream::pair().unwrap();
+    peer.shutdown(Shutdown::Write).unwrap();
+    let (replacement, mut writer) = UnixStream::pair().unwrap();
+    writer.write_all(b"same").unwrap();
+    let mut redial = OneRedial {
+        socket: Some(replacement),
+        deadline,
+    };
+    job.run_recovery(socket, &mut redial).unwrap();
+    assert!(redial.socket.is_none());
+    completed.recv_timeout(Duration::from_secs(1)).unwrap();
+    handoff.confirm_socket_retired().unwrap();
+    drop(handoff);
+    assert!(grant.lifecycle.lock().unwrap().seal_retired().is_ok());
+    drop((permit, config, grant, provider));
+    let mut supervisor = supervisor;
+    supervisor.close_admission();
+    supervisor.try_finish().unwrap();
+}
