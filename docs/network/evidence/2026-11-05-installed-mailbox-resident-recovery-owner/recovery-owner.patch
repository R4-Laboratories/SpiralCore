+#[cfg(all(target_os = "linux", target_pointer_width = "64"))]
+impl mvm_core::host_lifetime::InstalledMailboxReplacementAcceptor for ResidentRecoveryAcceptor<'_> {
+    fn accept_after_clean_close(
+        &mut self,
+        deadline: std::time::Instant,
+    ) -> std::io::Result<std::os::unix::net::UnixStream> {
+        let check = || {
+            self.grant
+                .check_native_mailbox_recovery(&self.grant.binding, self.plan, self.enrollment)
+                .map_err(std::io::Error::other)
+        };
+        check()?;
+        let socket = self.acceptor.accept_after_clean_close(deadline)?;
+        check()?;
+        Ok(socket)
+    }
+}
