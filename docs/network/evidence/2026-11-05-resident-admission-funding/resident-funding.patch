+// Included only in the isolated installed-resident test module.
+#[test]
+fn resident_admitted_launch_returns_unused_original_slot() {
+    const CHILD: &str = "SPIRALCORE_RESIDENT_ADMISSION_FIXTURE";
+    if std::env::var_os(CHILD).is_none() {
+        let home = tempfile::tempdir().unwrap();
+        let status = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "resident_admitted_launch_returns_unused_original_slot",
+                "--test-threads=1",
+                "--nocapture",
+            ])
+            .env(CHILD, "1")
+            .env("MVM_HOME", home.path())
+            .status()
+            .unwrap();
+        assert!(status.success());
+        return;
+    }
+
+    use mvm_core::plan::{
+        NetworkMode, PlanSeccompTier, SecretReleasePolicy, SynthesisInput, Variant,
+    };
+    use mvm_hostd::plan_admission::{InMemoryNonceLedger, RunPosture, SystemClock, admit_for_run};
+
+    let (backend, hypervisor) = if cfg!(target_os = "linux") {
+        (BackendKind::Firecracker, "firecracker")
+    } else {
+        (BackendKind::Hvf, "hvf")
+    };
+    let (_installation, mut service) =
+        prepared_service_with_backend(LocalBackend::with_hypervisor(hypervisor));
+    let keys = mvm_core::config::mvm_keys_dir();
+    let ledger = InMemoryNonceLedger::new();
+    let admit = |tenant| {
+        let input = SynthesisInput::builder()
+            .vm_name("resident-admitted-refusal")
+            .tenant(tenant)
+            .backend_name(hypervisor)
+            .image_name("fixture")
+            .image_sha256("deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef")
+            .seccomp_tier(PlanSeccompTier::Standard)
+            .secret_release(SecretReleasePolicy::None)
+            .secrets(Vec::new())
+            .network_mode(NetworkMode::default())
+            .cpus(1)
+            .mem_mib(1024)
+            .disk_mib(0)
+            .boot_timeout_secs(60)
+            .destroy_on_exit(true)
+            .shares(Vec::new())
+            .redaction(Default::default())
+            .reversible_replacement(Default::default())
+            .audit_labels(Default::default())
+            .services(Vec::new())
+            .stream_edges(Vec::new())
+            .stream_retention(Default::default())
+            .build()
+            .unwrap();
+        admit_for_run(
+            &input,
+            &SystemClock,
+            &ledger,
+            Some(&keys),
+            None,
+            RunPosture::on_backend(Variant::Dev, backend),
+        )
+        .expect("original token from actual MVM signed admission")
+    };
+
+    let before = service.usage().unwrap();
+    let vm = "resident-admitted-refusal";
+    // A fixed fixture fee proves ledger custody only. No shipping size claim.
+    let profile = QualifiedAdmissionFunding {
+        metadata_bytes: 16 << 20,
+    };
+    if std::env::var_os(CHILD).as_deref() == Some(std::ffi::OsStr::new("saturation")) {
+        let pool = &service.live.as_ref().unwrap().provider.shared.pool;
+        let all_local_credit = pool
+            .reserve(
+                tenant_tag("local"),
+                ManagedClaim {
+                    host_metadata_bytes: 256 << 20,
+                    ..Default::default()
+                },
+            )
+            .unwrap();
+        let saturated = service.usage().unwrap();
+        let public_signer = keys.join(mvm_hostd::audit::host_keypair::PUBLIC_FILENAME);
+        assert!(
+            !public_signer.exists(),
+            "isolated signer is initially absent"
+        );
+        assert!(
+            service
+                .begin_launch_admitted(request(vm), "local", &profile, || Ok(admit("local")))
+                .is_err(),
+            "resident must refuse under full tenant metadata usage"
+        );
+        assert!(!service.live.as_ref().unwrap().has_issued_vm);
+        assert_eq!(service.usage().unwrap().usage, saturated.usage);
+        assert!(!mvm_core::config::vm_state_dir(vm).exists());
+        assert!(
+            !public_signer.exists(),
+            "canonical admission created a signer before acquiring resident funding"
+        );
+        drop(all_local_credit);
+        service.try_finish().unwrap();
+        return;
+    }
+    assert!(
+        service
+            .begin_launch_admitted(request(vm), "local", &profile, || Ok(admit("foreign")))
+            .is_err(),
+        "foreign signed tenant must be refused before the resident issues a slot"
+    );
+    assert!(!service.live.as_ref().unwrap().has_issued_vm);
+    assert_eq!(service.usage().unwrap().usage, before.usage);
+
+    // This process deliberately has no global installed provider. The exact
+    // original local token reaches the Client's pure preflight, which returns
+    // both original owners. Resident must retire its exact unused slot.
+    assert!(mvm_hostd::host_lifetime_parent::require_installed().is_err());
+    let pool = service.live.as_ref().unwrap().provider.shared.pool.clone();
+    let id = service
+        .begin_launch_admitted(request(vm), "local", &profile, || {
+            let charged = pool.snapshot().unwrap();
+            assert_eq!(
+                charged.usage.host_metadata_bytes,
+                before.usage.host_metadata_bytes + profile.metadata_bytes
+            );
+            assert_eq!(charged.active_reservations, before.active_reservations + 1);
+            Ok(admit("local"))
+        })
+        .unwrap();
+    assert!(
+        service.usage().unwrap().usage.host_metadata_bytes
+            >= before.usage.host_metadata_bytes + profile.metadata_bytes
+    );
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()
+        .unwrap();
+    let progress = runtime.block_on(service.drive_once()).unwrap();
+    assert_eq!(progress.id, id);
+    assert_eq!(progress.state, ResidentStatus::UnusedRetired);
+    let after = service.usage().unwrap();
+    assert_eq!(after.usage, before.usage);
+    assert_eq!(after.active_reservations, before.active_reservations);
+    assert!(!mvm_core::config::vm_state_dir(vm).exists());
+    assert!(!mvm_core::config::machine_spec_path(vm).exists());
+    drop(pool);
+    service.try_finish().unwrap();
+}
