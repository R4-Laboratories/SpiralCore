+#[cfg(all(target_os = "linux", feature = "test-support"))]
+#[test]
+fn installed_mailbox_handoff_requires_original_funded_parent_once() {
+    use mvm_core::host_lifetime::{
+        CoreCurrentParentPermit, InstalledMailboxOwner, PreparedInstalledMailbox,
+    };
+    use mvm_core::plan::{PlanId, sign_plan, test_support::PlanFixture};
+
+    struct Charge(Arc<AtomicUsize>);
+    impl InstalledMailboxOwner for Charge {
+        fn check_current(&self) -> anyhow::Result<()> {
+            Ok(())
+        }
+    }
+    impl Drop for Charge {
+        fn drop(&mut self) {
+            self.0.fetch_add(1, Ordering::SeqCst);
+        }
+    }
+    enum Funding {
+        Original,
+        Foreign,
+        Exhausted,
+        Revoked,
+    }
+    struct MailboxParent {
+        original: HostLaunchBinding,
+        funding: Funding,
+        anchor: std::sync::Weak<mvm_core::host_lifetime::HostLifetimeAnchor>,
+        plan_json: String,
+        revoked: std::sync::atomic::AtomicBool,
+        calls: AtomicUsize,
+        drops: Arc<AtomicUsize>,
+    }
+    impl CoreCurrentParentPermit for MailboxParent {
+        fn check_current(&self, binding: &HostLaunchBinding) -> anyhow::Result<()> {
+            anyhow::ensure!(binding == &self.original, "foreign parent fixture");
+            anyhow::ensure!(!self.revoked.load(Ordering::SeqCst), "original parent revoked");
+            Ok(())
+        }
+
+        fn prepare_installed_mailbox(
+            &self,
+            binding: &HostLaunchBinding,
+            plan_id: &PlanId,
+        ) -> anyhow::Result<PreparedInstalledMailbox> {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            let anchor = self.anchor.upgrade().unwrap();
+            let mut config = VmStartConfig {
+                name: binding.vm_name.clone(),
+                cpus: binding.cpus,
+                memory_mib: binding.memory_mib,
+                plan_json: Some(self.plan_json.clone()),
+                ..Default::default()
+            };
+            anchor.bind_to_config(&mut config).unwrap();
+            assert!(anchor.take_installed_mailbox(&config, binding.backend).is_err());
+            assert!(anchor.prepare_installed_mailbox(&config, binding.backend).is_err());
+            let mut owner = binding.clone();
+            match self.funding {
+                Funding::Original => {}
+                Funding::Foreign => owner.grant_serial += 1,
+                Funding::Exhausted => anyhow::bail!("mailbox capacity exhausted"),
+                Funding::Revoked => self.revoked.store(true, Ordering::SeqCst),
+            }
+            Ok(PreparedInstalledMailbox::new(
+                owner,
+                plan_id.clone(),
+                Box::new(Charge(Arc::clone(&self.drops))),
+            ))
+        }
+    }
+
+    for funding in [Funding::Original, Funding::Foreign, Funding::Exhausted, Funding::Revoked] {
+        let accepted = matches!(funding, Funding::Original);
+        let root = tempfile::tempdir().unwrap();
+        let anchor = PreparedHostLifetime::bind(inputs(root.path()), ())
+            .unwrap()
+            .into_anchor();
+        let mut config = VmStartConfig {
+            name: "owned-test".into(),
+            cpus: 1,
+            memory_mib: 1024,
+            ..Default::default()
+        };
+        anchor.bind_to_config(&mut config).unwrap();
+        let mut plan = PlanFixture::new().build();
+        plan.resources.mem_mib = 1024;
+        plan.plan_id = mvm_core::plan::compute_plan_id(&plan);
+        config.plan_json = Some(
+            serde_json::to_string(&sign_plan(
+                &plan,
+                &ed25519_dalek::SigningKey::from_bytes(&[4; 32]),
+                "test",
+            ))
+            .unwrap(),
+        );
+        let backend = BackendKind::Firecracker;
+        anchor.bind_admitted(&config, backend, &plan).unwrap();
+        assert!(anchor.prepare_installed_mailbox(&config, backend).is_err());
+        let parent = Arc::new(MailboxParent {
+            original: anchor.binding().clone(),
+            funding,
+            anchor: Arc::downgrade(&anchor),
+            plan_json: config.plan_json.clone().unwrap(),
+            revoked: std::sync::atomic::AtomicBool::new(false),
+            calls: AtomicUsize::new(0),
+            drops: Arc::new(AtomicUsize::new(0)),
+        });
+        anchor
+            .bind_parent_permit(&config, backend, parent.clone())
+            .unwrap();
+        assert!(anchor.take_installed_mailbox(&config, backend).unwrap().is_none());
+        assert!(anchor.prepare_installed_mailbox(&config, BackendKind::Mock).is_err());
+        assert_eq!(parent.calls.load(Ordering::SeqCst), 0);
+
+        assert_eq!(anchor.prepare_installed_mailbox(&config, backend).is_ok(), accepted);
+        assert!(anchor.prepare_installed_mailbox(&config, backend).is_err());
+        assert_eq!(parent.calls.load(Ordering::SeqCst), 1);
+        assert!(anchor.claim_for_native(&config, backend).is_err());
+        if accepted {
+            let handoff = anchor.take_installed_mailbox(&config, backend).unwrap().unwrap();
+            assert!(handoff.retains_anchor(&anchor));
+            assert_eq!(handoff.plan_id(), &plan.plan_id);
+            assert_eq!(parent.drops.load(Ordering::SeqCst), 0);
+            assert!(anchor.take_installed_mailbox(&config, backend).is_err());
+            assert!(anchor.claim_for_native(&config, backend).is_err());
+            drop(handoff);
+            assert_eq!(parent.drops.load(Ordering::SeqCst), 1);
+        } else {
+            assert!(anchor.take_installed_mailbox(&config, backend).is_err());
+        }
+    }
+}
