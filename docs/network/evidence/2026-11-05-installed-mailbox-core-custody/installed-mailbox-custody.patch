+/// A funded mailbox owner supplied by the installed parent before any
+/// listener, worker, or guest effects. Dropping an inert owner is safe.
+pub trait InstalledMailboxOwner: Send + Sync {
+    fn check_current(&self) -> Result<()>;
+}
+
+/// The original parent's inert, identity-bound mailbox preparation.
+pub struct PreparedInstalledMailbox {
+    binding: HostLaunchBinding,
+    plan_id: PlanId,
+    owner: Box<dyn InstalledMailboxOwner>,
+}
+
+impl PreparedInstalledMailbox {
+    pub fn new(
+        binding: HostLaunchBinding,
+        plan_id: PlanId,
+        owner: Box<dyn InstalledMailboxOwner>,
+    ) -> Self {
+        Self { binding, plan_id, owner }
+    }
+}
+
+/// One-shot transfer of the actual owner, with the original launch anchor.
+#[must_use]
+pub struct InstalledMailboxHandoff {
+    prepared: PreparedInstalledMailbox,
+    anchor: Arc<HostLifetimeAnchor>,
+}
+
+impl InstalledMailboxHandoff {
+    pub fn plan_id(&self) -> &PlanId {
+        &self.prepared.plan_id
+    }
+
+    pub fn retains_anchor(&self, original: &Arc<HostLifetimeAnchor>) -> bool {
+        Arc::ptr_eq(&self.anchor, original)
+    }
+}
+
+#[derive(Default)]
+enum MailboxPreparation {
+    #[default]
+    Unselected,
+    // Pending, failed, and taken attempts all bar reuse and native activation.
+    Fenced,
+    Ready(Box<PreparedInstalledMailbox>),
+}
