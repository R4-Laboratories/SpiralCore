+    /// Prepare from the original, already-bound parent after Hostd selection.
+    /// The attempt is fenced before any parent callback can reenter.
+    pub fn prepare_installed_mailbox(
+        self: &Arc<Self>,
+        config: &VmStartConfig,
+        backend: BackendKind,
+    ) -> Result<()> {
+        ensure!(
+            cfg!(target_os = "linux") && backend == BackendKind::Firecracker,
+            "installed mailbox preparation requires Linux Firecracker"
+        );
+        self.verify_config(config, backend)?;
+        self.verify_admitted_config(config)?;
+        let plan_id = self
+            .admitted
+            .lock()
+            .map_err(|_| anyhow::anyhow!("host lifetime admission poisoned"))?
+            .as_ref()
+            .context("original admission missing")?
+            .plan_id
+            .clone();
+        let parent = self
+            .current_parent
+            .lock()
+            .map_err(|_| anyhow::anyhow!("host parent binding poisoned"))?
+            .as_ref()
+            .cloned()
+            .context("original parent resource permit missing")?;
+        {
+            let mut mailbox = self
+                .mailbox
+                .lock()
+                .map_err(|_| anyhow::anyhow!("installed mailbox preparation poisoned"))?;
+            ensure!(
+                matches!(*mailbox, MailboxPreparation::Unselected)
+                    && !self.native_claimed.load(Ordering::Acquire),
+                "installed mailbox preparation already attempted or native lifetime claimed"
+            );
+            *mailbox = MailboxPreparation::Fenced;
+        }
+
+        parent.check_current(&self.binding)?;
+        let prepared = parent.prepare_installed_mailbox(&self.binding, &plan_id)?;
+        ensure!(
+            prepared.binding == self.binding && prepared.plan_id == plan_id,
+            "installed mailbox differs from the original launch and plan"
+        );
+        prepared.owner.check_current()?;
+        self.verify_config(config, backend)?;
+        parent.check_current(&self.binding)?;
+        *self
+            .mailbox
+            .lock()
+            .map_err(|_| anyhow::anyhow!("installed mailbox preparation poisoned"))? =
+            MailboxPreparation::Ready(Box::new(prepared));
+        Ok(())
+    }
+
+    /// Move the original inert owner once, before any mailbox effects.
+    pub fn take_installed_mailbox(
+        self: &Arc<Self>,
+        config: &VmStartConfig,
+        backend: BackendKind,
+    ) -> Result<Option<InstalledMailboxHandoff>> {
+        self.verify_config(config, backend)?;
+        self.verify_admitted_config(config)?;
+        let prepared = {
+            let mut mailbox = self
+                .mailbox
+                .lock()
+                .map_err(|_| anyhow::anyhow!("installed mailbox preparation poisoned"))?;
+            match &*mailbox {
+                MailboxPreparation::Unselected => return Ok(None),
+                MailboxPreparation::Fenced => {
+                    anyhow::bail!("original installed mailbox preparation is unavailable")
+                }
+                MailboxPreparation::Ready(_) => {}
+            }
+            let MailboxPreparation::Ready(prepared) =
+                std::mem::replace(&mut *mailbox, MailboxPreparation::Fenced)
+            else {
+                unreachable!("mailbox preparation checked under the same lock")
+            };
+            *prepared
+        };
+        prepared.owner.check_current()?;
+        self.check_parent_current(config, backend)?;
+        Ok(Some(InstalledMailboxHandoff {
+            prepared,
+            anchor: Arc::clone(self),
+        }))
+    }
