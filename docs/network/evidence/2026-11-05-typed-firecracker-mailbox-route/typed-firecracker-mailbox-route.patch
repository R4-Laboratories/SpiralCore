+use super::{
+    GuestService, VsockDirection, VsockPort, mailbox_bridge::InstalledMailboxBridge,
+    mailbox_bridge_name, reject_raw_mailbox_channel,
+};
+use std::{
+    fs,
+    io::{Read, Write},
+    os::unix::{
+        fs::{DirBuilderExt, symlink},
+        net::{UnixListener, UnixStream},
+    },
+    path::PathBuf,
+    sync::atomic::{AtomicUsize, Ordering},
+};
+
+struct Fixture {
+    root: PathBuf,
+    runtime: PathBuf,
+    target: PathBuf,
+    link: PathBuf,
+}
+impl Fixture {
+    fn new() -> Self {
+        static NEXT: AtomicUsize = AtomicUsize::new(0);
+        let root = std::env::temp_dir().join(format!(
+            "sc-fc-mailbox-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::create_dir(&root).unwrap();
+        let runtime = root.join("runtime");
+        fs::DirBuilder::new().mode(0o700).create(&runtime).unwrap();
+        let target = root.join("mailbox.sock");
+        let link = runtime.join(mailbox_bridge_name());
+        Self {
+            root,
+            runtime,
+            target,
+            link,
+        }
+    }
+}
