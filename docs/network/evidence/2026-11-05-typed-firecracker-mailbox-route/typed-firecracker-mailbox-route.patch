+//! Exact guest-dial bridge for the installed Firecracker mailbox.
+use std::{
+    ffi::OsString,
+    fs::{self, File, Metadata, OpenOptions},
+    io,
+    os::{
+        fd::AsRawFd,
+        unix::fs::{MetadataExt, OpenOptionsExt, symlink},
+    },
+    path::{Path, PathBuf},
+};
+
+enum State {
+    Reserved,
+    Uncertain(Option<File>),
+    Armed(File),
+    Unlinked,
+    Retired,
+}
+
+/// The installed native owner retains this record until verified child exit.
+/// Entry mutation is exclusive to the cooperating original driver. Drop does
+/// not infer exit or remove a name whose original identity is uncertain.
+pub(super) struct InstalledMailboxBridge {
+    directory: Option<File>,
+    directory_path: PathBuf,
+    name: OsString,
+    target: PathBuf,
+    state: State,
+}
+
+impl InstalledMailboxBridge {
+    pub(super) fn reserve(directory_path: &Path, target: &Path) -> io::Result<Self> {
+        if !directory_path.is_absolute() || !target.is_absolute() {
+            return Err(io::Error::other("installed mailbox paths must be absolute"));
+        }
+        let directory = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW)
+            .open(directory_path)?;
+        let bridge = Self {
+            directory: Some(directory),
+            directory_path: directory_path.to_owned(),
+            name: super::mailbox_bridge_name(),
+            target: target.to_owned(),
+            state: State::Reserved,
+        };
+        bridge.verify_directory()?;
+        bridge.require_absent()?;
+        Ok(bridge)
+    }
+
+    pub(super) fn verify_reserved(&self, current_target: &Path) -> io::Result<()> {
+        if !matches!(self.state, State::Reserved) || current_target != self.target {
+            return Err(io::Error::other(
+                "installed mailbox bridge reservation differs",
+            ));
+        }
+        self.verify_directory()?;
+        self.require_absent()
+    }
+
+    pub(super) fn arm(&mut self) -> io::Result<()> {
+        if !matches!(self.state, State::Reserved) {
+            return Err(io::Error::other(
+                "installed mailbox bridge already attempted",
+            ));
+        }
+        self.verify_directory()?;
+        symlink(&self.target, self.anchored_entry())?;
+        self.state = State::Uncertain(None);
+        let pin = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_PATH | libc::O_NOFOLLOW)
+            .open(self.anchored_entry())?;
+        self.state = State::Uncertain(Some(pin));
+        let State::Uncertain(Some(pin)) = &self.state else {
+            unreachable!()
+        };
+        self.check_link(pin)?;
+        let State::Uncertain(Some(pin)) =
+            std::mem::replace(&mut self.state, State::Uncertain(None))
+        else {
+            unreachable!()
+        };
+        self.state = State::Armed(pin);
+        self.directory().sync_all()
+    }
+
+    pub(super) fn verify(&self, current_target: &Path) -> io::Result<()> {
+        let State::Armed(pin) = &self.state else {
+            return Err(io::Error::other("original mailbox bridge is not armed"));
+        };
+        if current_target != self.target {
+            return Err(io::Error::other("installed mailbox bridge target differs"));
+        }
+        self.verify_directory()?;
+        self.check_link(pin)
+    }
+
+    pub(super) fn retire(&mut self) -> io::Result<()> {
+        match &self.state {
+            State::Reserved | State::Retired => return Ok(()),
+            State::Uncertain(_) => {
+                return Err(io::Error::other(
+                    "original mailbox bridge identity unavailable",
+                ));
+            }
+            State::Armed(pin) => {
+                self.verify_directory()?;
+                self.check_link(pin)?;
+                fs::remove_file(self.anchored_entry())?;
+                self.state = State::Unlinked;
+            }
+            State::Unlinked => self.verify_directory()?,
+        }
+        self.require_absent()?;
+        self.directory().sync_all()?;
+        self.verify_directory()?;
+        self.require_absent()?;
+        self.state = State::Retired;
+        Ok(())
+    }
+
+    fn verify_directory(&self) -> io::Result<()> {
+        let held = self.directory().metadata()?;
+        let named = fs::symlink_metadata(&self.directory_path)?;
+        mvm_core::private_fs::require_current_owner(&held)?;
+        if !held.is_dir()
+            || !named.is_dir()
+            || !same_object(&held, &named)
+            || held.mode() & 0o022 != 0
+        {
+            return Err(io::Error::other(
+                "installed mailbox bridge directory changed",
+            ));
+        }
+        Ok(())
+    }
+
+    fn check_link(&self, pin: &File) -> io::Result<()> {
+        let entry = self.anchored_entry();
+        let held = pin.metadata()?;
+        let named = fs::symlink_metadata(&entry)?;
+        if !held.is_symlink()
+            || !named.is_symlink()
+            || !same_object(&held, &named)
+            || fs::read_link(entry)? != self.target
+        {
+            return Err(io::Error::other(
+                "original installed mailbox bridge changed",
+            ));
+        }
+        Ok(())
+    }
+
+    fn require_absent(&self) -> io::Result<()> {
+        match fs::symlink_metadata(self.anchored_entry()) {
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+            Err(error) => Err(error),
+            Ok(_) => Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "installed mailbox bridge entry occupied",
+            )),
+        }
+    }
+
+    fn anchored_entry(&self) -> PathBuf {
+        PathBuf::from(format!("/proc/self/fd/{}", self.directory().as_raw_fd())).join(&self.name)
+    }
+
+    fn directory(&self) -> &File {
+        self.directory
+            .as_ref()
+            .expect("original bridge directory custody")
+    }
+}
+
+impl Drop for InstalledMailboxBridge {
+    fn drop(&mut self) {
+        if matches!(
+            self.state,
+            State::Uncertain(_) | State::Armed(_) | State::Unlinked
+        ) {
+            // Unknown exit or cleanup must retain original namespace custody.
+            std::mem::forget((
+                self.directory.take(),
+                std::mem::replace(&mut self.state, State::Retired),
+            ));
+        }
+    }
+}
+
+fn same_object(a: &Metadata, b: &Metadata) -> bool {
+    (a.dev(), a.ino()) == (b.dev(), b.ino())
+}
