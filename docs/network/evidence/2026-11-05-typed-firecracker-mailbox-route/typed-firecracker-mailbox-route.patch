+//! Original Linux mailbox listener identity and accepting lifetime.
+use std::{
+    fs::{self, File, Metadata},
+    io,
+    os::{
+        fd::AsRawFd,
+        unix::{
+            fs::{FileTypeExt, MetadataExt},
+            net::UnixListener,
+        },
+    },
+    path::{Path, PathBuf},
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+};
+
+const NAME: &str = "mailbox.sock";
+
+/// The worker owns this non-cloneable guard. Exit or stop invalidates all
+/// observations. Only creation of a new worker can make a new guard.
+pub(super) struct Accepting {
+    open: Arc<AtomicBool>,
+    owner: std::sync::Weak<()>,
+}
+
+impl Accepting {
+    pub(super) fn for_owner(owner: &Arc<()>) -> Self {
+        Self {
+            open: Arc::new(AtomicBool::new(true)),
+            owner: Arc::downgrade(owner),
+        }
+    }
+
+    pub(super) fn close(&self) {
+        self.open.store(false, Ordering::Release);
+    }
+}
+
+impl Drop for Accepting {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+
+/// A physical observation of the pinned original Runtime socket. A caller
+/// must separately verify the original admitted launch and service owner.
+pub struct PinnedListener {
+    directory: File,
+    socket: File,
+    path: PathBuf,
+    accepting: Arc<AtomicBool>,
+    owner: std::sync::Weak<()>,
+}
+
+impl PinnedListener {
+    pub(super) fn capture(
+        directory: &File,
+        path: &Path,
+        listener: &UnixListener,
+        accepting: &Accepting,
+    ) -> io::Result<Self> {
+        let anchored = anchored_path(directory);
+        if !path.is_absolute()
+            || path.file_name().is_none_or(|name| name != NAME)
+            || listener.local_addr()?.as_pathname() != Some(anchored.as_path())
+        {
+            return Err(io::Error::other(
+                "mailbox listener is not bound to the original directory",
+            ));
+        }
+        // O_PATH pins the filesystem entry without opening a connection.
+        // O_NOFOLLOW lets verification reject a symlink as the pinned entry.
+        use rustix::fs::{Mode, OFlags, open};
+        let socket = File::from(open(
+            anchored,
+            OFlags::PATH | OFlags::NOFOLLOW | OFlags::CLOEXEC,
+            Mode::empty(),
+        )?);
+        let proof = Self {
+            directory: directory.try_clone()?,
+            socket,
+            path: path.to_owned(),
+            accepting: Arc::clone(&accepting.open),
+            owner: accepting.owner.clone(),
+        };
+        proof.verify()?;
+        Ok(proof)
+    }
+
+    pub(super) fn belongs_to(&self, owner: &Arc<()>) -> bool {
+        self.owner.ptr_eq(&Arc::downgrade(owner))
+    }
+
+    pub fn verify(&self) -> io::Result<&Path> {
+        self.check_accepting()?;
+        let directory = self.directory.metadata()?;
+        let named =
+            fs::symlink_metadata(self.path.parent().expect("validated absolute mailbox path"))?;
+        let euid = rustix::process::geteuid().as_raw();
+        if !directory.is_dir()
+            || !named.is_dir()
+            || !same_object(&directory, &named)
+            || directory.uid() != euid
+            || directory.mode() & 0o7777 != 0o700
+        {
+            return Err(io::Error::other(
+                "original private mailbox directory changed",
+            ));
+        }
+        let socket = self.socket.metadata()?;
+        let anchored = fs::symlink_metadata(anchored_path(&self.directory))?;
+        let named = fs::symlink_metadata(&self.path)?;
+        if !socket.file_type().is_socket()
+            || !anchored.file_type().is_socket()
+            || !named.file_type().is_socket()
+            || !same_object(&socket, &anchored)
+            || !same_object(&socket, &named)
+            || socket.uid() != euid
+        {
+            return Err(io::Error::other("original mailbox socket identity changed"));
+        }
+        self.check_accepting()?;
+        Ok(&self.path)
+    }
+
+    pub fn verify_expected_object(&self, device: u64, inode: u64) -> io::Result<()> {
+        let socket = self.socket.metadata()?;
+        if (socket.dev(), socket.ino()) != (device, inode) {
+            return Err(io::Error::other(
+                "original mailbox socket changed before pinning",
+            ));
+        }
+        Ok(())
+    }
+
+    pub fn invalidate(&self) {
+        self.accepting.store(false, Ordering::Release);
+    }
+
+    fn check_accepting(&self) -> io::Result<()> {
+        if self.accepting.load(Ordering::Acquire) {
+            Ok(())
+        } else {
+            Err(io::Error::other(
+                "original mailbox worker is no longer accepting",
+            ))
+        }
+    }
+}
+
+fn anchored_path(directory: &File) -> PathBuf {
+    PathBuf::from(format!("/proc/self/fd/{}", directory.as_raw_fd())).join(NAME)
+}
+
+fn same_object(a: &Metadata, b: &Metadata) -> bool {
+    (a.dev(), a.ino()) == (b.dev(), b.ino())
+}
