+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+
+    #[test]
+    fn recovery_verifies_the_original_entry_without_reviving_boot_readiness() {
+        let home = tempfile::tempdir().unwrap();
+        fs::set_permissions(home.path(), fs::Permissions::from_mode(0o700)).unwrap();
+        let directory = File::open(home.path()).unwrap();
+        let original = home.path().join(NAME);
+        let renamed = home.path().join("original.sock");
+        let listener = UnixListener::bind(anchored_path(&directory)).unwrap();
+        let owner = Arc::new(());
+        let accepting = Accepting::for_owner(&owner);
+        let pinned = PinnedListener::capture(&directory, &original, &listener, &accepting).unwrap();
+
+        assert_eq!(pinned.verify().unwrap(), original);
+        accepting.close();
+        assert!(pinned.verify().is_err());
+        assert_eq!(pinned.verify_original_identity().unwrap(), original);
+
+        fs::rename(&original, &renamed).unwrap();
+        let foreign = UnixListener::bind(&original).unwrap();
+        assert!(pinned.verify_original_identity().is_err());
+        drop(foreign);
+        fs::remove_file(&original).unwrap();
+        fs::rename(&renamed, &original).unwrap();
+        assert_eq!(pinned.verify_original_identity().unwrap(), original);
+
+        drop(owner);
+        assert!(pinned.verify_original_identity().is_err());
+        assert!(pinned.verify().is_err());
+    }
+}
