+            let mut slot = parent
+                .mailbox_broker
+                .lock()
+                .map_err(|_| anyhow!("resident mailbox broker state poisoned"))?;
+            if let Some(current) = slot.upgrade() {
+                current
+            } else {
+                let metadata = parent.pool.reserve(
+                    tenant_tag("installation-mailbox-broker"),
+                    ManagedClaim {
+                        host_metadata_bytes: MIB,
+                        ..Default::default()
+                    },
+                )?;
