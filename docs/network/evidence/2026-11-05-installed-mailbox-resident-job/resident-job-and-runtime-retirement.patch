+//! One issued socket job's service and worker retirement fence.
+use std::{
+    io,
+    sync::{
+        Arc,
+        atomic::{AtomicU8, Ordering},
+    },
+};
+
+#[derive(Clone, Copy)]
+#[repr(u8)]
+enum Phase {
+    Unissued,
+    Issued,
+    Running,
+    Drained,
+    Abandoned,
+    Retired,
+    Quarantined,
+}
+
+pub(in crate::installed_parent) struct JobFence(AtomicU8);
+
+impl Default for JobFence {
+    fn default() -> Self {
+        Self(AtomicU8::new(Phase::Unissued as u8))
+    }
+}
+
+impl JobFence {
+    fn transition(&self, from: Phase, to: Phase) -> io::Result<()> {
+        self.0
+            .compare_exchange(from as u8, to as u8, Ordering::AcqRel, Ordering::Acquire)
+            .map(|_| ())
+            .map_err(|_| io::Error::other("original mailbox job state changed"))
+    }
+
+    pub(in crate::installed_parent) fn issue(self: &Arc<Self>) -> io::Result<JobTicket> {
+        self.transition(Phase::Unissued, Phase::Issued)?;
+        Ok(JobTicket(Arc::clone(self)))
+    }
+
+    /// The original Runtime owner calls this after join and socket cleanup.
+    pub(in crate::installed_parent) fn confirm_retired(&self) -> io::Result<()> {
+        let phase = self.0.load(Ordering::Acquire);
+        if phase == Phase::Retired as u8 {
+            return Ok(());
+        }
+        if phase == Phase::Drained as u8 {
+            self.transition(Phase::Drained, Phase::Retired)
+        } else if phase == Phase::Abandoned as u8 {
+            self.transition(Phase::Abandoned, Phase::Retired)
+        } else {
+            Err(io::Error::other("original mailbox service did not drain"))
+        }
+    }
+
+    /// Refuse refund for any issued or running job without both proofs.
+    /// A quarantined ticket cannot start late or turn cleanup into a refund.
+    pub(in crate::installed_parent) fn release_or_quarantine(&self) -> bool {
+        loop {
+            let phase = self.0.load(Ordering::Acquire);
+            if phase == Phase::Unissued as u8
+                || phase == Phase::Abandoned as u8
+                || phase == Phase::Retired as u8
+            {
+                return true;
+            }
+            if self
+                .0
+                .compare_exchange(
+                    phase,
+                    Phase::Quarantined as u8,
+                    Ordering::AcqRel,
+                    Ordering::Acquire,
+                )
+                .is_ok()
+            {
+                return false;
+            }
+        }
+    }
+}
+
+pub(in crate::installed_parent) struct JobTicket(Arc<JobFence>);
+
+impl JobTicket {
+    pub(in crate::installed_parent) fn enter(&self) -> io::Result<()> {
+        self.0.transition(Phase::Issued, Phase::Running)
+    }
+
+    pub(in crate::installed_parent) fn drained(self) -> io::Result<()> {
+        self.0.transition(Phase::Running, Phase::Drained)
+    }
+}
+
+impl Drop for JobTicket {
+    fn drop(&mut self) {
+        let _ = self.0.transition(Phase::Issued, Phase::Abandoned);
+    }
+}
