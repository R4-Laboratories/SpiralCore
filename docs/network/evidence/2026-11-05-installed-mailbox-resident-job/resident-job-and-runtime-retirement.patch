+//! A mailbox job belongs to the original installed grant and broker.
+use super::ManagedReservation;
+use anyhow::{Context, Result};
+use mvm_core::host_lifetime::InstalledMailboxJob;
+use spiralcore_mvm_adapter::{broker::BrokerContext, service::LocalMailboxService};
+use std::{io, os::unix::net::UnixStream, sync::Arc};
+
+mod fence;
+use fence::{JobFence, JobTicket};
+
+type ServiceJob = Box<
+    dyn FnOnce(UnixStream, &BrokerContext, &mut LocalMailboxService) -> io::Result<()>
+        + Send
+        + Sync
+        + 'static,
+>;
+
+pub(super) struct ResidentBroker {
+    context: BrokerContext,
+    _metadata: ManagedReservation,
+}
+
+pub(super) struct FundedMailboxJob {
+    callback: Option<ServiceJob>,
+    broker: Arc<ResidentBroker>,
+    fence: Arc<JobFence>,
+    workspace: ManagedReservation,
+}
+
+impl FundedMailboxJob {
+    pub(super) fn check_current(&self) -> Result<()> {
+        self.broker._metadata.check_current()?;
+        self.workspace.check_current()?;
+        Ok(())
+    }
+
+    pub(super) fn take_socket_job(&mut self) -> Result<InstalledMailboxJob> {
+        self.check_current()?;
+        let callback = self
+            .callback
+            .take()
+            .context("original mailbox job consumed")?;
+        let issued = IssuedJob {
+            callback,
+            broker: Arc::clone(&self.broker),
+            ticket: self.fence.issue()?,
+        };
+        Ok(Box::new(move |socket| issued.run(socket)))
+    }
+
+    pub(super) fn confirm_socket_retired(&self) -> Result<()> {
+        Ok(self.fence.confirm_retired()?)
+    }
+
+    pub(super) fn release_or_quarantine(&self) -> bool {
+        self.fence.release_or_quarantine()
+    }
+
+    pub(super) fn release(self) -> Result<()> {
+        let Self {
+            callback,
+            broker,
+            fence,
+            workspace,
+        } = self;
+        drop((callback, broker, fence));
+        Ok(workspace.release_exclusive()?)
+    }
+}
+
+// The ticket drops after the callback and broker. Abandonment cannot make
+// their workspace releasable while a never-started closure still owns them.
+struct IssuedJob {
+    callback: ServiceJob,
+    broker: Arc<ResidentBroker>,
+    ticket: JobTicket,
+}
+impl IssuedJob {
+    fn run(self, socket: UnixStream) -> io::Result<()> {
+        self.ticket.enter()?;
+        let Self {
+            callback,
+            broker,
+            ticket,
+        } = self;
+        let context = &broker.context;
+        let mut service = context
+            .with_time(|budget, _| LocalMailboxService::new(budget.clone()))
+            .map_err(io::Error::other)?;
+        let result = callback(socket, context, &mut service);
+        context
+            .with_time(|_, now| service.shutdown(now))
+            .map_err(io::Error::other)?;
+        drop(service);
+        drop(broker);
+        ticket.drained()?;
+        result
+    }
+}
+
+// Registration remains private to qualification until the canonical enrolled
+// mailbox service can supply a session bound to the original admission.
+#[cfg(test)]
+impl super::VmGrant {
+    pub(super) fn install_mailbox_job(
+        &self,
+        admitted: &super::AdmittedPlan,
+        job: impl FnOnce(UnixStream, &BrokerContext, &mut LocalMailboxService) -> io::Result<()>
+        + Send
+        + Sync
+        + 'static,
+    ) -> Result<()> {
