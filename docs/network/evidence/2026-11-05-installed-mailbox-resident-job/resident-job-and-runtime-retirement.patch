+            state.mailbox == MailboxFunding::Selected
+                && state.admitted_plan.as_deref() == Some(admitted.plan_id().0.as_str())
+                && state.mailbox_job.is_none(),
+            "original mailbox selection unavailable or already provisioned"
+        );
+        state.mailbox_job = Some(candidate);
+        Ok(())
+    }
