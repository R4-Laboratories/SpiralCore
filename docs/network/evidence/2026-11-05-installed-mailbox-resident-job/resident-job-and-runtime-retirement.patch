+            tenant_tag(&self.tenant),
+            ManagedClaim {
+                host_plaintext_bytes: MIB,
+                host_carrier_bytes: 2 * MIB,
+                host_metadata_bytes: MIB,
+                ..Default::default()
+            },
+        )?;
