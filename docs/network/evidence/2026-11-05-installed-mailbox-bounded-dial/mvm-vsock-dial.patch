+/// Start one AF_VSOCK connect and bound its wait by the original deadline.
+/// Writable readiness is only a carrier candidate. The caller must still
+/// authenticate the intended peer on this same descriptor.
+pub fn dial_before(cid: u32, port: u32, deadline: std::time::Instant) -> io::Result<OwnedFd> {
+    check_connect_deadline(deadline)?;
+    let fd = vsock_stream_socket(sock::SockFlag::SOCK_NONBLOCK)?;
+    match sock::connect(fd.as_raw_fd(), &sock::VsockAddr::new(cid, port)) {
+        Ok(()) => check_connect_deadline(deadline)?,
+        Err(nix::errno::Errno::EINPROGRESS) => {
+            wait_for_connect_candidate(fd.as_raw_fd(), deadline)?;
+        }
+        Err(error) => return Err(io::Error::from(error)),
+    }
+    Ok(fd)
+}
+
+fn check_connect_deadline(deadline: std::time::Instant) -> io::Result<()> {
+    if std::time::Instant::now() >= deadline {
+        return Err(io::ErrorKind::TimedOut.into());
+    }
+    Ok(())
+}
+
+fn wait_for_connect_candidate(
+    fd: std::os::fd::RawFd,
+    deadline: std::time::Instant,
+) -> io::Result<()> {
+    loop {
+        let remaining = deadline.saturating_duration_since(std::time::Instant::now());
+        if remaining.is_zero() {
+            return Err(io::ErrorKind::TimedOut.into());
+        }
+        let timeout = libc::timespec {
+            tv_sec: remaining
+                .as_secs()
+                .try_into()
+                .map_err(|_| io::ErrorKind::InvalidInput)?,
+            tv_nsec: remaining.subsec_nanos() as libc::c_long,
+        };
+        let mut poll = libc::pollfd {
+            fd,
+            events: libc::POLLOUT | libc::POLLRDHUP,
+            revents: 0,
+        };
+        // SAFETY: caller owns a live fd, and both ppoll arguments refer to
+        // initialized, suitably sized stack objects for this syscall.
+        let count = unsafe { libc::ppoll(&mut poll, 1, &timeout, std::ptr::null()) };
+        check_connect_deadline(deadline)?;
+        if count < 0 {
+            let error = io::Error::last_os_error();
+            if error.kind() == io::ErrorKind::Interrupted {
+                continue;
+            }
+            return Err(error);
+        }
+        if count == 0 {
+            continue;
+        }
+        if poll.revents & (libc::POLLERR | libc::POLLHUP | libc::POLLRDHUP | libc::POLLNVAL) != 0
+            || poll.revents & libc::POLLOUT == 0
+        {
+            return Err(io::ErrorKind::ConnectionAborted.into());
+        }
+        // Linux can also report writable on a closing vsock. This only
+        // authorizes attempting the pinned session proof, never mailbox I/O.
+        return Ok(());
+    }
+}
