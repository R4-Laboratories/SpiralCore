+                .registry
+                .lock()
+                .map_err(|_| anyhow!("parent registry poisoned"))?;
+            ensure!(!registry.closed, "parent admission closed");
+            let mut state = self
+                .lifecycle
+                .lock()
+                .map_err(|_| anyhow!("parent lifecycle poisoned"))?;
+            state.check_launch_open()?;
+            ensure!(
+                state.mailbox == MailboxFunding::Preparing,
+                "mailbox preparation state changed"
+            );
+            owner.phase = MailboxFunding::Held(serial);
+            state.mailbox = owner.phase;
+        }
+        Ok(PreparedInstalledMailbox::new(
+            binding.clone(),
+            plan_id.clone(),
+            Box::new(owner),
+        ))
