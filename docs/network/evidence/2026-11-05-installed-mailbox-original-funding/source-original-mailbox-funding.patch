+#[cfg(target_os = "linux")]
+#[test]
+fn installed_mailbox_funding_uses_original_selected_grant_and_host_ledger() {
+    for (selected, full) in [(true, false), (true, true), (false, false)] {
+        let (home, mut supervisor, provider) = endpoint_tests::fixture();
+        let name = "funded-mailbox-vm";
+        let admitted = admitted_with_mailbox(home.path(), name, selected);
+        let (grant, mut config) = config(&provider, name);
+        config.plan_json = Some(serde_json::to_string(admitted.signed()).unwrap());
+        let permit = provider
+            .bind_config(&admitted, &config, native_backend())
+            .unwrap();
+        let erased: Arc<dyn CoreCurrentParentPermit> = grant.clone();
+        assert!(Arc::ptr_eq(&permit, &erased));
+        let anchor = config.host_lifetime.as_ref().unwrap();
+        anchor
+            .bind_parent_permit(&config, native_backend(), permit)
+            .unwrap();
+
+        if selected {
+            let error = anchor
+                .claim_for_native(&config, native_backend())
+                .err()
+                .expect("the selected original grant must fence native before preparation");
+            assert!(format!("{error:#}").contains("original mailbox worker"));
+        }
+
+        let pool = supervisor.managed_resources();
+        let occupied = full.then(|| {
+            let used = pool.snapshot().unwrap().usage.workers;
+            pool.reserve(
+                tenant_tag("local"),
+                ManagedClaim {
+                    workers: pool.limits().workers - used,
+                    ..ManagedClaim::default()
+                },
+            )
+            .unwrap()
+        });
+        let before = pool.snapshot().unwrap().usage;
+        let prepared = anchor.prepare_installed_mailbox(&config, native_backend());
+        if selected && !full {
+            prepared.expect("selected mailbox must reserve one original worker");
+            let funded = pool.snapshot().unwrap().usage;
+            assert_eq!(funded.workers, before.workers + 1);
+            let stack = native_thread_stack_terms(MAILBOX_WORKER_STACK_BYTES)
+                .unwrap()
+                .known_rust_bytes;
+            assert_eq!(funded.host_stack_bytes, before.host_stack_bytes + stack);
+            assert_eq!(
+                funded.host_metadata_bytes,
+                before.host_metadata_bytes + BOOKKEEPING_BYTES
+            );
+            assert!(
+                grant
+                    .prepare_installed_mailbox(&grant.binding, admitted.plan_id())
+                    .is_err()
+            );
+            assert_eq!(pool.snapshot().unwrap().usage, funded);
+            assert!(grant.lifecycle.lock().unwrap().seal_retired().is_err());
+            let owner = anchor
+                .take_installed_mailbox(&config, native_backend())
+                .unwrap()
+                .unwrap();
+            assert!(owner.retains_anchor(anchor));
+            assert_eq!(owner.plan_id(), admitted.plan_id());
+            assert_eq!(pool.snapshot().unwrap().usage, funded);
+            drop(owner);
+            assert_eq!(pool.snapshot().unwrap().usage, before);
+            assert!(
+                grant
+                    .prepare_installed_mailbox(&grant.binding, admitted.plan_id())
+                    .is_err()
+            );
+            assert!(grant.lifecycle.lock().unwrap().seal_retired().is_ok());
+        } else {
+            let error = prepared.unwrap_err();
+            if full {
+                assert!(format!("{error:#}").contains("managed resources: Full"));
+            } else {
+                assert!(format!("{error:#}").contains("original mailbox selection"));
+            }
+            assert_eq!(pool.snapshot().unwrap().usage, before);
+            assert!(
+                anchor
+                    .take_installed_mailbox(&config, native_backend())
+                    .is_err()
+            );
+            assert!(grant.lifecycle.lock().unwrap().seal_retired().is_ok());
+        }
+        drop((occupied, erased, config, grant, provider));
+        supervisor.close_admission();
+        supervisor.try_finish().unwrap();
+    }
