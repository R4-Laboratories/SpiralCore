+    /// Release a sole inert credit and verify that the original ledger
+    /// no longer contains its serial. Normal admission closure permits this.
+    pub(crate) fn release_exclusive(self) -> Result<()> {
+        let reservation = Arc::try_unwrap(self.owner).map_err(|_| ManagedResourceError::State)?;
+        let shared = Arc::clone(&reservation.shared);
+        let (slot, serial) = (reservation.slot, reservation.serial);
+        drop(reservation);
+
+        let ledger = shared.ledger()?;
+        if shared.fenced.load(Ordering::Acquire)
+            || ledger.slots[slot].is_some_and(|entry| entry.serial == serial)
+        {
+            return Err(ManagedResourceError::State);
+        }
+        Ok(())
+    }
