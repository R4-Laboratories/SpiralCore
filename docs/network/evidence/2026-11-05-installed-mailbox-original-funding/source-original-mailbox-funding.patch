+/// A pre-effect mailbox reservation. The active worker will need a separate
+/// joined-retirement path before it can release these resources.
+struct InertMailboxCredit {
+    grant: Weak<VmGrant>,
+    credit: Option<ManagedReservation>,
+    phase: MailboxFunding,
+}
+
+impl InstalledMailboxOwner for InertMailboxCredit {
+    fn check_current(&self) -> Result<()> {
+        self.credit
+            .as_ref()
+            .context("original mailbox credit missing")?
+            .check_current()?;
+        let grant = self
+            .grant
+            .upgrade()
+            .context("original mailbox grant unavailable")?;
+        grant.check_open()?;
+        let state = grant
+            .lifecycle
+            .lock()
+            .map_err(|_| anyhow!("parent lifecycle poisoned"))?;
+        ensure!(
+            !state.retired && state.mailbox == self.phase,
+            "original mailbox credit substituted"
+        );
+        Ok(())
+    }
+}
+
+impl Drop for InertMailboxCredit {
+    fn drop(&mut self) {
+        let Some(credit) = self.credit.take() else {
+            return;
+        };
+        if credit.release_exclusive().is_ok()
+            && let Some(grant) = self.grant.upgrade()
+        {
+            let _ = grant.finish_inert_mailbox(self.phase);
+        }
+    }
+}
+
+impl VmGrant {
+    fn finish_inert_mailbox(&self, phase: MailboxFunding) -> Result<()> {
+        let mut state = self
+            .lifecycle
+            .lock()
+            .map_err(|_| anyhow!("parent lifecycle poisoned"))?;
+        ensure!(
+            state.mailbox == phase,
+            "original mailbox funding state changed"
+        );
+        state.mailbox = MailboxFunding::InertDone;
+        Ok(())
+    }
+}
