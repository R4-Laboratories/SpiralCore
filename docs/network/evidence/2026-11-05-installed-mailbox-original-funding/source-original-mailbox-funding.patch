+struct SignedMailboxFixture {
+    archive: Vec<u8>,
+    publisher: ed25519_dalek::VerifyingKey,
+    pin: mvm_core::plan::bundle::PlanArtifact,
+}
+
+impl SignedMailboxFixture {
+    fn new() -> Self {
+        use ed25519_dalek::Signer;
+        use mvm_core::plan::bundle::{
+            ARTIFACTS_DIR, ArtifactRole, BUNDLE_SCHEMA_VERSION, BundleArtifact, BundleManifest,
+            PlanArtifact, bundle_sha256, canonical_manifest_bytes, key_id_from_pubkey, sha256_hex,
+            write_bundle,
+        };
+        let signing = ed25519_dalek::SigningKey::from_bytes(&[62; 32]);
+        let publisher = signing.verifying_key();
+        let key_id = key_id_from_pubkey(&publisher);
+        let parts = [
+            (
+                "vmlinux",
+                ArtifactRole::Kernel,
+                b"fixture-kernel".as_slice(),
+            ),
+            (
+                "rootfs.ext4",
+                ArtifactRole::Rootfs,
+                b"fixture-rootfs".as_slice(),
+            ),
+        ];
+        let manifest = BundleManifest {
+            schema_version: BUNDLE_SCHEMA_VERSION,
+            publisher: "test".into(),
+            key_id: key_id.clone(),
+            arch: mvm_core::arch::GuestArch::host().to_string(),
+            kernel_version: None,
+            profile: None,
+            workload_label: None,
+            created_at: "2026-05-13T00:00:00Z".into(),
+            labels: Default::default(),
+            artifacts: parts
+                .iter()
+                .map(|(name, role, bytes)| BundleArtifact {
+                    name: (*name).into(),
+                    role: role.clone(),
+                    path: format!("{ARTIFACTS_DIR}/{name}"),
+                    sha256: sha256_hex(bytes),
+                    size_bytes: bytes.len() as u64,
+                })
+                .collect(),
+            members: Vec::new(),
+            verity: None,
+            resources: None,
+        };
+        let signature = signing.sign(&canonical_manifest_bytes(&manifest).unwrap());
+        let archive = write_bundle(
+            &manifest,
+            &signing,
+            parts
+                .into_iter()
+                .map(|(name, _, bytes)| (format!("{ARTIFACTS_DIR}/{name}"), bytes.to_vec()))
+                .collect(),
+        )
+        .unwrap();
+        let pin = PlanArtifact::new(bundle_sha256(&archive), &signature.to_bytes(), key_id);
+        Self {
+            archive,
+            publisher,
+            pin,
+        }
+    }
