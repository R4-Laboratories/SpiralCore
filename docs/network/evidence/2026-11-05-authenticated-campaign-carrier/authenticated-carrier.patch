+/// A campaign carrier can only be minted by the existing installed pin
+/// authentication. It carries the exact endpoint bootstrap used for its route.
+pub(crate) struct AuthenticatedCampaignCarrier<'a, S: SocketIo> {
+    endpoint: &'a Bootstrap,
+    stream: StreamTransport<S>,
+    cancel: CancellationToken,
+}
+
+impl<'a, S: SocketIo + 'static> AuthenticatedCampaignCarrier<'a, S> {
+    fn open(
+        endpoint: &'a Bootstrap,
+        socket: S,
+        role: HandshakeRole,
+        pin: &RecoveryPin,
+    ) -> Result<Self> {
+        campaign::validate_service_bootstrap(endpoint)?;
+        let cancel = CancellationToken::default();
+        let stream = Peer::carrier(
+            endpoint,
+            socket,
+            role,
+            &cancel,
+            Some((pin, Instant::now() + RECOVERY_CAP)),
+        )?;
+        Ok(Self {
+            endpoint,
+            stream,
+            cancel,
+        })
+    }
+
+    pub(crate) fn into_parts(self) -> (&'a Bootstrap, StreamTransport<S>, CancellationToken) {
+        (self.endpoint, self.stream, self.cancel)
+    }
+}
