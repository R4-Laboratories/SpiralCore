+use super::*;
+use spiralcore_transfer::endpoint::Limits;
+
+fn pins() -> (RecoveryPin, RecoveryPin) {
+    let guest = SigningKey::from_bytes(&[11; 32]);
+    let host = SigningKey::from_bytes(&[12; 32]);
+    let session = "installed-campaign-component/v1".to_owned();
+    (
+        RecoveryPin {
+            session: session.clone(),
+            signing_key: guest.to_bytes(),
+            peer: host.verifying_key().to_bytes(),
+        },
+        RecoveryPin {
+            session,
+            signing_key: host.to_bytes(),
+            peer: guest.verifying_key().to_bytes(),
+        },
+    )
+}
+
+#[test]
+fn authenticated_carrier_runs_exact_campaign_on_borrowed_service() {
+    let pair = Pair::provision(Plan {
+        stage: Stage::Two,
+        arm: Arm::Raw,
+        size: 128,
+        trial: 2,
+        bandwidth_profile: Default::default(),
+    })
+    .unwrap();
+    let (guest_pin, host_pin) = pins();
+    let (guest, host) = UnixStream::pair().unwrap();
+    let guest = GuestSocket::new(guest).unwrap();
+    let sender = campaign::broker_context().unwrap();
+    let receiver = campaign::broker_context().unwrap();
+    let mut original = receiver
+        .with_time(|budget, _| LocalMailboxService::new(budget.clone()))
+        .unwrap();
+    let root = tempfile::tempdir().unwrap();
+    let cache = root.path().join("cache");
+    let (sent, received) = std::thread::scope(|scope| {
+        let endpoint = &pair.receiver;
+        let receiver = &receiver;
+        let original = &mut original;
+        let cache = &cache;
+        let worker = scope.spawn(move || {
+            let carrier = AuthenticatedCampaignCarrier::open(
+                endpoint,
+                host,
+                HandshakeRole::Acceptor,
+                &host_pin,
+            )
+            .unwrap();
+            campaign::receiver_on_authenticated(
+                carrier,
+                receiver,
+                original,
+                cache,
+                Limits {
+                    max_active: 1,
+                    resident_bytes: 4 << 20,
+                    cache_bytes: 4 << 20,
+                    namespace_bytes: 4 << 20,
+                    ..Limits::default()
+                },
+                &mut std::io::sink(),
+            )
+            .unwrap()
+        });
+        let carrier = AuthenticatedCampaignCarrier::open(
+            &pair.sender,
+            guest,
+            HandshakeRole::Initiator,
+            &guest_pin,
+        )
+        .unwrap();
+        let sent =
+            campaign::sender_on_authenticated(carrier, &sender, &mut std::io::sink()).unwrap();
+        (sent, worker.join().unwrap())
+    });
+    assert_eq!(received["exact_reopened"], true);
+    let published: Vec<crate::config::Published> =
+        serde_json::from_value(received["published"].clone()).unwrap();
+    campaign::verify(&pair.sender.plan, &cache, &published, &mut std::io::sink()).unwrap();
+    let calls = sent["service"]["application_calls"].as_u64().unwrap();
+    assert_eq!(received["service"]["application_calls"], calls);
+    for (a, b) in [(&sent, &received), (&received, &sent)] {
+        for stem in ["envelope_bytes", "framing_bytes", "frames"] {
+            assert_eq!(
+                a["counters"][format!("{stem}_sent")],
+                b["counters"][format!("{stem}_received")]
+            );
+        }
+        assert_eq!(a["counters"]["frames_sent"], calls * 2);
+    }
+    let state = original.snapshot();
+    assert_eq!(state.accepted as u64, calls);
+    assert_eq!((state.fifo_scopes, state.fifo_entries), (1, 0));
+    receiver.with_time(|_, now| original.shutdown(now)).unwrap();
+    println!(
+        "{}",
+        serde_json::json!({
+            "application_calls": calls,
+            "publication_lengths": published.iter().map(|p| p.length).collect::<Vec<_>>(),
+            "sender": {"counters": sent["counters"], "cpu_us": sent["cpu_us"], "wall_us": sent["wall_us"]},
+            "receiver": {"counters": received["counters"], "cpu_us": received["cpu_us"], "wall_us": received["wall_us"]},
+        })
+    );
+}
+
+#[test]
+fn wrong_enrolled_pin_cannot_create_campaign_carrier() {
+    let pair = Pair::provision(Plan {
+        stage: Stage::Two,
+        arm: Arm::Raw,
+        size: 128,
+        trial: 2,
+        bandwidth_profile: Default::default(),
+    })
+    .unwrap();
+    let (mut guest_pin, host_pin) = pins();
+    guest_pin.peer = SigningKey::from_bytes(&[13; 32]).verifying_key().to_bytes();
+    let (guest, host) = UnixStream::pair().unwrap();
+    std::thread::scope(|scope| {
+        let worker = scope.spawn(|| {
+            AuthenticatedCampaignCarrier::open(
+                &pair.receiver,
+                host,
+                HandshakeRole::Acceptor,
+                &host_pin,
+            )
+        });
+        assert!(
+            AuthenticatedCampaignCarrier::open(
+                &pair.sender,
+                guest,
+                HandshakeRole::Initiator,
+                &guest_pin,
+            )
+            .is_err()
+        );
+        let _ = worker.join().unwrap();
+    });
+}
