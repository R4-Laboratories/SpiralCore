+
+#[test]
+fn replacement_profile_requires_its_exact_signed_enrollment_before_spending_nonce() {
+    use mvm_core::plan::NetworkMode;
+
+    let (_env, _home) = host_with_ceiling(Default::default());
+    let keys = tempfile::tempdir().unwrap();
+    let publisher = ed25519_dalek::SigningKey::from_bytes(&[56; 32]);
+    let (archive, pin) = make_test_bundle(&publisher, b"kernel-bytes", b"rootfs-bytes");
+    let key_id = key_id_from_pubkey(&publisher.verifying_key());
+    let trust = MapTrust(HashMap::from([(key_id, publisher.verifying_key())]));
+    let resolver = FixedResolver(archive);
+    let context = BundleAdmissionContext {
+        resolver: &resolver,
+        trust: &trust,
+        image: None,
+    };
+    let legacy = InstalledMailboxLaunchProfile::LinuxFirecrackerV1;
+    let recovery = InstalledMailboxLaunchProfile::LinuxFirecrackerRecoveryV2;
+    let asset = recovery.signed_asset().unwrap();
+    assert_ne!(asset, legacy.signed_asset().unwrap());
+    let enrollment = InstalledMailboxEnrollment::new([83; 32]).unwrap();
+    let foreign = InstalledMailboxEnrollment::new([84; 32]).unwrap();
+    let posture = RunPosture::on_backend(Variant::Dev, BackendKind::Firecracker);
+    let admit = |plan: &ExecutionPlan, ledger: &InMemoryNonceLedger, posture| {
+        admit_plan_for_run(
+            plan,
+            &SystemClock,
+            ledger,
+            Some(keys.path()),
+            Some(&context),
+            None,
+            posture,
+        )
+    };
+
+    let mut input = input_with_pin("installed-mailbox-replacement", &pin);
+    input.backend_name = "firecracker";
+    input.network_mode = NetworkMode::HostVsockProxy;
+    input.assets.push(asset);
+    let unsigned_enrollment = synthesize_plan(&input).unwrap();
+    assert!(
+        admit(
+            &unsigned_enrollment,
+            &InMemoryNonceLedger::new(),
+            posture.with_installed_mailbox(recovery),
+        )
+        .is_err()
+    );
+
+    input.assets.push(enrollment.signed_asset().unwrap());
+    let plan = synthesize_plan(&input).unwrap();
+    let ledger = InMemoryNonceLedger::new();
+    for refused in [
+        posture,
+        posture.with_installed_mailbox_enrollment(legacy, enrollment),
+        posture.with_installed_mailbox_enrollment(recovery, foreign),
+    ] {
+        assert!(admit(&plan, &ledger, refused).is_err());
+    }
+    let admitted = admit(
+        &plan,
+        &ledger,
+        posture.with_installed_mailbox_enrollment(recovery, enrollment),
+    )
+    .expect("refused recovery selections must not spend the exact nonce");
+    assert_eq!(admitted.installed_mailbox(), Some(recovery));
+    assert_eq!(admitted.installed_mailbox_enrollment(), Some(enrollment));
+}
